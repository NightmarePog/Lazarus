// The Lazarus compiler: resolve imports, lex, parse, analyse, optimise and emit
// one runnable Lua 5.1 chunk to stdout.
//
//   lua Main.lua path/to/Entry.laz   # bundle a file together with its imports
//   lua Main.lua < some.laz          # compile stdin as a single class "Main"
//   lua Main.lua                     # compile the built-in sample

import std.Str
import std.Sys
import backend.Text
import frontend.lexer.Lexer
import frontend.parser.Node
import frontend.parser.Parser
import frontend.schematic.Schematic
import frontend.typecheck.Typecheck
import frontend.optimizer.Optimizer
import Expander
import backend.Codegen
import backend.Bundler
import backend.MetaEmitter
import backend.linker.Linker
import Error


constructor() {
    mut path = Sys.argv(1)
    if path.is_some() {
        mut plat = ""
        mut pkg_path = ""
        mut is_lib = false
        mut is_check = false
        mut i = 2
        loop {
            mut flag = Sys.argv(i)
            if flag.is_none() {
                break
            }
            mut f = flag.unwrap()
            if f == "--platform" {
                i = i + 1
                mut val = Sys.argv(i)
                if val.is_some() {
                    plat = val.unwrap()
                }
            } else if f == "--pkg-path" {
                i = i + 1
                mut val = Sys.argv(i)
                if val.is_some() {
                    pkg_path = val.unwrap()
                } else {
                    Error("MissingFlagValue", "--pkg-path requires a directory argument", 0, 0, "", 1).raise()
                }
            } else if f == "--lib" {
                is_lib = true
            } else if f == "--check" {
                is_check = true
            }
            i = i + 1
        }
        if is_check {
            Main.check_file(path.unwrap(), pkg_path)
        } else if is_lib {
            Main.build_lib(path.unwrap(), plat, pkg_path)
        } else {
            Main.build_file(path.unwrap(), plat, pkg_path)
        }
    } else {
        Error("NoFileAppended", "No file appended, use 'lazarus <FILE.laz>'", 0, 0, "", 2).raise()
    }
}

// Syntax-check + semantic-analysis mode: lex, parse, and run Schematic on the
// file without following imports. Outputs errors as JSON lines on stdout (one
// object per error), then exits 0. Used by the LSP to get diagnostics.
private static lua check_file(path: str, pkg_path: str): unit {
    _G._lz_check_mode = true
    local f = io.open(path, 'r')
    if not f then
        print('{"kind":"IOError","line":0,"col":0,"message":"cannot read file"}')
        os.exit(0)
    end
    local source = f:read('*a')
    f:close()
    local kind = 'class'
    if path:match('%.object%.laz$') then kind = 'object'
    elseif path:match('%.trait%.laz$') then kind = 'trait' end
    local tokens = Lexer.new(source):scan()
    local program = Parser.new(tokens, source, kind):parse()
    -- Semantic pass: collect enums/imports from this file, then run Schematic.
    -- Cross-module registries (variant_owner etc.) are empty — we do not follow
    -- imports, so imported enums are unknown, but per-file errors are still caught.
    local stem = path:match('([^/%.]+)%.class%.laz$')
              or path:match('([^/%.]+)%.object%.laz$')
              or path:match('([^/%.]+)%.trait%.laz$')
              or path:match('([^/%.]+)%.laz$')
              or 'Check'
    local variant_owner = Map.__lz_from({})
    local enums        = Map.__lz_from({})
    local variant_arity = Map.__lz_from({})
    local variant_fields = Map.__lz_from({})
    local enum_type_params = Map.__lz_from({})
    local gated_externs = Map.__lz_from({})
    Main.collect_enums(program, variant_owner, enums, variant_arity, variant_fields, enum_type_params)
    local imports = List.new()
    for _, node in List.__lz_each(program:child('body')) do
        if node.kind == 'ImportDecl' then
            List.push(imports, node:child('name'))
        end
    end
    Schematic.analyze(program, source, stem, imports, variant_owner, enums, variant_arity, gated_externs)
    os.exit(0)
}

// A file entry point: follow its imports and bundle the whole program. Each
// module is analysed and optimised on its own before the bundler composes them.
// Output is written to <EntryClass>.lua with a LAZARUS_META header.
static build_file(path: str, plat: str, pkg_path: str): unit {
    mut linker = Linker(path, pkg_path)
    mut modules = linker.link()

    mut variant_owner = [:]
    mut enums = [:]
    mut variant_arity = [:]
    mut variant_fields = [:]
    mut enum_type_params = [:]
    mut classes = [:]
    mut traits = [:]
    mut gated_externs = [:]

    for m in modules {
        if not m.is_prebuilt {
            Main.collect_enums(m.ast, variant_owner, enums, variant_arity, variant_fields, enum_type_params)
            Main.collect_traits(m.ast, traits, m.class_name)
        }
    }

    mut handler_cache = [:]
    for m in modules {
        if not m.is_trait and not m.is_prebuilt {
            Expander(m.class_name, handler_cache).expand(m.ast, modules)
        }
    }

    for m in modules {
        if m.is_prebuilt {
            classes[m.class_name] = m.meta_sig
        } else if not m.is_trait {
            Main.collect_signatures(m.ast, m.class_name, classes, plat, gated_externs)
        }
    }

    for m in modules {
        if not m.is_trait and not m.is_prebuilt {
            Schematic.analyze(m.ast, m.source, m.class_name, m.imports, variant_owner, enums, variant_arity, gated_externs)
            Typecheck(m.source, m.class_name, m.imports, enums, classes, variant_fields, variant_owner, enum_type_params, traits).check(m.ast)
            Optimizer().optimize(m.ast)
        }
    }

    mut entry_class = linker.entry_class()
    mut bundle = Bundler(modules, entry_class, variant_owner, plat).bundle()

    mut entry_sig = classes.get(entry_class).unwrap_or(0)
    mut meta_block = ""
    if entry_sig != 0 {
        meta_block = MetaEmitter.emit(entry_class, entry_sig) ++ Text.nl() ++ Text.nl()
    }

    mut out_path = entry_class ++ ".lua"
    mut file = Sys.open(out_path, "w").unwrap()
    file.write(meta_block ++ bundle)
    file.close()
}

// Library compilation: analyse the entry module (and its imports for typechecking),
// then emit ONLY the entry class block — no stdlib prelude, no entry-point call.
// Output is <EntryClass>.lua with a LAZARUS_META header. The file can be imported
// as a prebuilt library by other programs without recompilation.
static build_lib(path: str, plat: str, pkg_path: str): unit {
    mut linker = Linker(path, pkg_path)
    mut modules = linker.link()

    mut variant_owner = [:]
    mut enums = [:]
    mut variant_arity = [:]
    mut variant_fields = [:]
    mut enum_type_params = [:]
    mut classes = [:]
    mut traits = [:]
    mut gated_externs = [:]

    for m in modules {
        if not m.is_prebuilt {
            Main.collect_enums(m.ast, variant_owner, enums, variant_arity, variant_fields, enum_type_params)
            Main.collect_traits(m.ast, traits, m.class_name)
        }
    }

    mut handler_cache = [:]
    for m in modules {
        if not m.is_trait and not m.is_prebuilt {
            Expander(m.class_name, handler_cache).expand(m.ast, modules)
        }
    }

    for m in modules {
        if m.is_prebuilt {
            classes[m.class_name] = m.meta_sig
        } else if not m.is_trait {
            Main.collect_signatures(m.ast, m.class_name, classes, plat, gated_externs)
        }
    }

    for m in modules {
        if not m.is_trait and not m.is_prebuilt {
            Schematic.analyze(m.ast, m.source, m.class_name, m.imports, variant_owner, enums, variant_arity, gated_externs)
            Typecheck(m.source, m.class_name, m.imports, enums, classes, variant_fields, variant_owner, enum_type_params, traits).check(m.ast)
            Optimizer().optimize(m.ast)
        }
    }

    mut entry_class = linker.entry_class()
    mut entry_module = modules.get(modules.len()).unwrap()
    mut externs = [:]
    for m in modules {
        if not m.is_prebuilt {
            mut binds = [:]
            for node in m.ast.child("body") {
                if node.kind == "ExternDecl" {
                    mut rt = node.attr("return_type")
                    mut wrap = true
                    if rt.is_some() {
                        mut rname = rt.unwrap().child("name")
                        wrap = rname == "Option" or rname == "dynamic"
                    }
                    binds[node.child("name")] = ["target": node.child("target"), "wrap": wrap]
                }
            }
            if binds.len() > 0 {
                externs[m.class_name] = binds
            }
        }
    }
    mut cg = Codegen(entry_class, entry_module.imports, externs, variant_owner, plat)
    mut class_block = cg.class_block(entry_module.ast)

    mut entry_sig = classes.get(entry_class).unwrap_or(0)
    mut meta_block = ""
    if entry_sig != 0 {
        meta_block = MetaEmitter.emit(entry_class, entry_sig) ++ Text.nl() ++ Text.nl()
    }

    mut out_path = entry_class ++ ".lua"
    mut file = Sys.open(out_path, "w").unwrap()
    file.write(meta_block ++ class_block)
    file.close()
}

// Gather every module's enum declarations into a program-wide registry, so a
// `match` is checked for exhaustiveness against an enum imported from any file:
// `enums[name]` is the variant list, `variant_owner[variant]` its enum, and
// `variant_fields[variant]` its payload type nodes (to type pattern bindings).
static collect_enums(ast: Node, variant_owner: Map<str, str>, enums: Map<str, List<str>>, variant_arity: Map<str, int>, variant_fields: Map<str, List<Node>>, enum_type_params: Map<str, List<str>>): unit {
    for stmt in ast.child("body") {
        if stmt.kind == "EnumDecl" {
            mut name = stmt.child("name")
            enum_type_params[name] = stmt.attr("type_params").unwrap_or([])
            mut names = []
            for v in stmt.child("variants") {
                mut vn = v.child("name")
                names.push(vn)
                variant_owner[vn] = name
                variant_arity[vn] = v.child("fields").len()
                variant_fields[vn] = v.child("fields")
            }
            enums[name] = names
        }
    }
}

// Gather one module's class signature into the program-wide `classes` registry,
// so the checker can type construction, calls and member access across files.
// Each entry carries `fields` (property name -> Option of its type node), `methods`
// (name -> {params, result, is_static, type_params}), `ctor` (the constructor's
// param-type nodes, or 0 when the class declares none) and `type_params`.
static collect_signatures(ast: Node, class_name: str, classes: Map<str, dynamic>, plat: str, gated_externs: Map<str, str>): unit {
    mut fields = [:]
    mut methods = [:]
    mut ctor = 0
    mut ctor_names = []
    mut type_params = []
    for stmt in ast.child("body") {
        mut k = stmt.kind
        if k == "VariableDecl" {
            mut visibility = stmt.attr("visibility").unwrap_or("")
            mut is_static = stmt.attr("is_static").unwrap_or(false)
            if visibility != "" and not is_static {
                fields[stmt.child("name")] = stmt.attr("type")
            }
        } else if k == "FunctionDecl" {
            mut params = stmt.attr("param_types").unwrap_or([])
            mut param_names = stmt.child("params")
            mut result = stmt.attr("return_type").unwrap_or(0)
            mut is_static = stmt.attr("is_static").unwrap_or(false)
            mut mtype_params = stmt.attr("type_params").unwrap_or([])
            methods[stmt.child("name")] = ["params": params, "param_names": param_names, "result": result, "is_static": is_static, "type_params": mtype_params]
        } else if k == "ConstructorDecl" {
            ctor = stmt.attr("param_types").unwrap_or([])
            ctor_names = stmt.child("params")
            type_params = stmt.attr("type_params").unwrap_or([])
        } else if k == "ExternDecl" {
            mut params = stmt.attr("param_types").unwrap_or([])
            mut all_typed = true
            for pt in params {
                if pt.attr("inferred").unwrap_or(false) or pt.child("name") == "dynamic" {
                    all_typed = false
                }
            }
            if all_typed and params.len() > 0 {
                mut extern_platform = stmt.attr("platform").unwrap_or("")
                mut ename = stmt.child("name")
                if extern_platform == "" or extern_platform == plat {
                    mut extern_result = stmt.attr("return_type").unwrap_or(0)
                    methods[ename] = ["params": params, "result": extern_result, "is_static": true, "type_params": []]
                    gated_externs.delete(ename)
                } else if not methods.has(ename) {
                    gated_externs[ename] = extern_platform
                }
            }
        }
    }
    classes[class_name] = ["fields": fields, "methods": methods, "ctor": ctor, "ctor_names": ctor_names, "type_params": type_params]
}

// Gather every trait declaration (inline or a `#trait` file, whose decl carries an
// empty name filled here from the filename) into the program-wide `traits` registry,
// so the checker can resolve trait annotations and run structural conformance. Each
// entry holds `methods` (name -> {params, result, type_params}), `properties`
// (name -> type node) and the trait's `type_params`.
static collect_traits(ast: Node, traits: Map<str, dynamic>, class_name: str): unit {
    for stmt in ast.child("body") {
        if stmt.kind == "TraitDecl" {
            mut name = stmt.child("name")
            if name == "" {
                name = class_name
            }
            mut methods = [:]
            for m in stmt.child("methods") {
                methods[m.child("name")] = ["params": m.child("param_types"), "result": m.child("return_type"), "type_params": m.child("type_params")]
            }
            mut properties = [:]
            for p in stmt.child("properties") {
                properties[p.child("name")] = p.child("type")
            }
            traits[name] = ["methods": methods, "properties": properties, "type_params": stmt.child("type_params")]
        }
    }
}
