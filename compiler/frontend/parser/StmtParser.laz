// StmtParser — the statement and block grammar over a shared TokenCursor. Most
// nodes come from the `Ast` factory; the four kinds with optional attributes
// (VariableDecl, ReturnStmt, IfStmt, ForStmt) assemble their attrs here and use
// `Ast.node` (an absent optional is a missing key).
//
// Grammar methods are named `parse_*`: a method named like an `Ast` factory (e.g.
// `while_stmt`) would be mis-compiled into a self-call, since a call's field name
// resolves against the current class before the receiver.

import frontend.lexer.Token
import frontend.parser.Ast
import frontend.parser.ExprParser
import frontend.parser.Node
import frontend.parser.TokenCursor
import std.Str

private static compounds = [
    "PLUS_ASSIGN": "PLUS",
    "MINUS_ASSIGN": "MINUS",
    "STAR_ASSIGN": "MULTIPLY",
    "SLASH_ASSIGN": "DIVIDE"
]

private cursor: TokenCursor
private exprs: ExprParser
private kind: str
@auto
constructor(cursor: TokenCursor, exprs: ExprParser, kind: str)

public parse_program(): Node {
    if .kind == "object" {
        return .parse_object_body()
    }
    if .kind == "trait" {
        return .parse_trait_body()
    }
    mut body = []
    loop {
        if .cursor.at_end() {
            break
        }
        body.push(.parse_statement())
    }
    // Filter sentinel nodes injected during error recovery, then report all errors.
    mut clean = [s for s in body if s.kind != "ErrorNode"]
    if .cursor.has_errors() {
        .cursor.flush()
    }
    return Ast.program(.expand_field_params(clean))
}

// A `.`-prefixed constructor param (`constructor(.cursor, .exprs)`) declares the
// field too: inject a private instance-property for each, so the rest of the
// pipeline sees an ordinary class. The `.f = f` assignments are added in
// `parse_constructor`.
private expand_field_params(body: List<Node>): List<Node> {
    mut props = []
    for stmt in body {
        if stmt.kind == "ConstructorDecl" {
            for fp in stmt.attr("field_params").unwrap_or([]) {
                props.push(.field_property(fp))
            }
        }
    }
    if props.len() == 0 {
        return body
    }
    mut out = []
    for p in props {
        out.push(p)
    }
    for stmt in body {
        out.push(stmt)
    }
    return out
}

private field_property<A>(fp: A): Node {
    return Ast.node("VariableDecl", ["name": fp.get("name").unwrap(), "visibility": "private", "mutable": false, "is_static": false, "type": fp.get("type").unwrap(), "line": fp.get("line").unwrap(), "col": fp.get("col").unwrap()])
}

// `#trait` body: signatures + property requirements (and imports), folded into
// one trait decl named after the file (empty name filled in downstream).
private parse_trait_body(): Node {
    mut type_params = []
    if .cursor.check("LESS") {
        type_params = .parse_type_params()
    }
    mut body = []
    mut methods = []
    mut properties = []
    loop {
        if .cursor.at_end() {
            break
        }
        if .cursor.check("IMPORT") {
            mut itok = .cursor.current()
            .cursor.advance()
            body.push(.parse_import(itok))
        } else {
            .parse_trait_member(methods, properties)
        }
    }
    body.push(Ast.trait_decl("", methods, properties, type_params, 1, 1))
    mut clean = [s for s in body if s.kind != "ErrorNode"]
    if .cursor.has_errors() {
        .cursor.flush()
    }
    return Ast.program(clean)
}

// `#object` body: a static module — every member is forced static, so the file
// emits a plain all-static class. `static` and `constructor` are rejected.
private parse_object_body(): Node {
    mut body = []
    loop {
        if .cursor.at_end() {
            break
        }
        if .cursor.check("IMPORT") {
            mut itok = .cursor.current()
            .cursor.advance()
            body.push(.parse_import(itok))
        } else {
            body.push(.parse_object_member())
        }
    }
    mut clean = [s for s in body if s.kind != "ErrorNode"]
    return Ast.program(clean)
}

private parse_object_member(): Node {
    if .cursor.check("EXTERN") {
        mut etok = .cursor.current()
        .cursor.advance()
        return .parse_extern(etok)
    }
    mut visibility = ""
    if .cursor.match("PRIVATE") {
        visibility = "private"
    } else if .cursor.match("PUBLIC") {
        visibility = "public"
    }
    if .cursor.check("STATIC") {
        .cursor.advance()
        .cursor.fail("'static' is implied in an #object file; remove it")
        return Ast.error_node()
    }
    if .cursor.check("CONSTRUCTOR") {
        .cursor.advance()
        .cursor.fail("an #object file has no instances; remove the constructor")
        return Ast.error_node()
    }
    if .cursor.match("LUA") {
        return .parse_lua_decl(visibility, true)
    }
    if .cursor.check("IDENTIFIER") and .looks_like_decl() {
        return .parse_method(visibility, true)
    }
    mut mutable = .cursor.match("MUTABLE")
    return .parse_binding(visibility, mutable, "Expected a member name in the #object file", true)
}

private parse_statement(): Node {
    mut tok = .cursor.current()
    match tok.kind {
        "IMPORT" => { .cursor.advance() return .parse_import(tok) }
        "EXTERN" => { .cursor.advance() return .parse_extern(tok) }
        "LUA" => { .cursor.advance() return .parse_lua_decl("", false) }
        "ENUM" => { .cursor.advance() return .parse_enum(tok) }
        "TRAIT" => { .cursor.advance() return .parse_trait(tok) }
        "IMPLEMENT" => { .cursor.advance() return .parse_implement(tok) }
        "PRIVATE" => { .cursor.advance() return .parse_member("private") }
        "PUBLIC" => { .cursor.advance() return .parse_member("public") }
        "MUTABLE" => { .cursor.advance() return .parse_binding("", true, "Expected variable name after 'mut'", false) }
        "STATIC" => { .cursor.advance() return .parse_static() }
        "AT" => { return .parse_annotation() }
        "CONSTRUCTOR" => { .cursor.advance() return .parse_constructor(tok) }
        "RETURN" => { .cursor.advance() return .parse_return(tok) }
        "IF" => { .cursor.advance() return .parse_if(tok) }
        "WHILE" => { .cursor.advance() return .parse_while(tok) }
        "LOOP" => { .cursor.advance() return .parse_loop(tok) }
        "FOR" => { .cursor.advance() return .parse_for(tok) }
        "BREAK" => { .cursor.advance() return .parse_break(tok) }
        "IDENTIFIER" => { return .parse_identifier_statement(tok) }
        _ => {}
    }
    return .parse_expr_statement(tok)
}

// At a statement head, an identifier may open a `match`, a typed local
// `x: T = …`, a method declaration, a plain assignment, or an expression
// statement — told apart by what follows.
private parse_identifier_statement(tok: Token): Node {
    if tok.value == "match" and .starts_match() {
        .cursor.advance()
        return .parse_match(tok)
    }
    if .cursor.peek_next().kind == "COLON" {
        return .parse_typed_local(tok)
    }
    if .looks_like_decl() {
        return .parse_method("", false)
    }
    mut nk = .cursor.peek_next().kind
    if nk == "ASSIGN" or .compound(nk).is_some() {
        return .parse_assignment("Expected variable name")
    }
    return .parse_expr_statement(tok)
}

// A braced block `{ <statement>* }`; `context` names it for error messages.
private parse_block(context: str): List<Node> {
    mut open = .cursor.consume("BODY_START", "Expected '{' to open " ++ context)
    mut body = []
    loop {
        if .cursor.at_end() {
            .cursor.fail_at("Expected '}' to close " ++ context, open.line, open.column, 1)
            break
        }
        if .cursor.check("BODY_END") {
            break
        }
        body.push(.parse_statement())
    }
    .cursor.consume("BODY_END", "Expected '}' to close " ++ context)
    return body
}

private parse_import(tok: Token): Node {
    mut first = .cursor.consume("IDENTIFIER", "Expected a name after 'import'")
    mut segments = [first.value]
    mut last = first.value
    loop {
        if not .cursor.match("DOT") {
            break
        }
        mut seg = .cursor.consume("IDENTIFIER", "Expected a name after '.' in an import path")
        segments.push(seg.value)
        last = seg.value
    }
    return Ast.import_decl(segments, last, tok.line, tok.column)
}

// `enum Name { A, B(T), C }` — PascalCase variant names, optionally carrying
// payload types, separated by a newline or an optional comma.
private parse_enum(tok: Token): Node {
    mut name = .cursor.consume("IDENTIFIER", "Expected an enum name after 'enum'")
    mut type_params = .parse_type_params()
    mut open = .cursor.consume("BODY_START", "Expected '{' to open enum body")
    mut variants = []
    loop {
        if .cursor.at_end() {
            .cursor.fail_at("Expected '}' to close enum body", open.line, open.column, 1)
            break
        }
        if .cursor.check("BODY_END") {
            break
        }
        variants.push(.parse_enum_variant())
        .cursor.match("COMMA")
    }
    .cursor.consume("BODY_END", "Expected '}' to close enum body")
    return Ast.enum_decl(name.value, variants, tok.line, tok.column, type_params)
}

private parse_enum_variant(): Node {
    mut v = .cursor.consume("IDENTIFIER", "Expected a variant name in the enum body")
    mut fields = []
    if .cursor.match("LEFT_BRACKET") {
        if not .cursor.check("RIGHT_BRACKET") {
            loop {
                fields.push(.parse_type())
                if not .cursor.match("COMMA") {
                    break
                }
            }
        }
        .cursor.consume("RIGHT_BRACKET", "Expected ')' after the variant payload types")
    }
    return Ast.enum_variant(v.value, fields, v.line, v.column)
}

// `trait Name<T> { fetch(): int  ;  name: str }` — a structural contract of
// method signatures (no bodies) and property requirements. Shares the member
// grammar with the `#trait` file form.
private parse_trait(tok: Token): Node {
    mut name = .cursor.consume("IDENTIFIER", "Expected a trait name after 'trait'")
    mut type_params = .parse_type_params()
    mut open = .cursor.consume("BODY_START", "Expected '{' to open trait body")
    mut methods = []
    mut properties = []
    loop {
        if .cursor.at_end() {
            .cursor.fail_at("Expected '}' to close trait body", open.line, open.column, 1)
            break
        }
        if .cursor.check("BODY_END") {
            break
        }
        .parse_trait_member(methods, properties)
    }
    .cursor.consume("BODY_END", "Expected '}' to close trait body")
    return Ast.trait_decl(name.value, methods, properties, type_params, tok.line, tok.column)
}

// One trait requirement: a method signature `name<T>(params): ret` (a `<` or
// `(` follows the name) or a property `name: Type`.
private parse_trait_member(methods: List<Node>, properties: List<Node>): unit {
    mut name = .cursor.consume("IDENTIFIER", "Expected a member name in the trait body")
    if .cursor.check("LESS") or .cursor.check("LEFT_BRACKET") {
        mut type_params = .parse_type_params()
        .cursor.consume("LEFT_BRACKET", "Expected '(' in a trait method signature")
        mut param_types = []
        .parse_params(param_types)
        .cursor.consume("RIGHT_BRACKET", "Expected ')' in a trait method signature")
        mut return_type = .parse_return_type()
        methods.push(Ast.trait_method(name.value, param_types, return_type, type_params))
    } else {
        .cursor.consume("COLON", "Expected ':' for a trait property requirement")
        properties.push(Ast.trait_property(name.value, .parse_type()))
    }
}

// `implement TraitName` — declares that this class satisfies the named trait.
private parse_implement(tok: Token): Node {
    mut name = .cursor.consume("IDENTIFIER", "Expected a trait name after 'implement'")
    return Ast.implement_decl(name.value, tok.line, tok.column)
}

// `[visibility] [static] lua name<T>(params): return_type LUA_BODY`
// The LUA keyword has already been consumed by the caller.
private parse_lua_decl(visibility: str, is_static: bool): Node {
    mut name = .cursor.consume("IDENTIFIER", "Expected function name after 'lua'")
    mut type_params = .parse_type_params()
    .cursor.consume("LEFT_BRACKET", "Expected '(' after lua function name")
    mut param_types = []
    mut params = .parse_params(param_types)
    .cursor.consume("RIGHT_BRACKET", "Expected ')' after lua function parameters")
    mut return_type = .parse_return_type()
    mut body_tok = .cursor.consume("LUA_BODY", "Expected '{' to open lua function body")
    return Ast.lua_decl(name.value, params, param_types, return_type, body_tok.value, is_static, visibility, name.line, name.column, type_params)
}

private parse_extern(tok: Token): Node {
    mut name = .cursor.consume("IDENTIFIER", "Expected a name after 'extern'")
    .cursor.consume("LEFT_BRACKET", "Expected '(' after extern name")
    mut param_types = []
    mut params = .parse_params(param_types)
    .cursor.consume("RIGHT_BRACKET", "Expected ')' after extern parameters")
    mut return_type = .parse_return_type()
    .cursor.consume("ASSIGN", "Expected '=' after extern parameters")
    mut target = .cursor.consume("STRING", "Expected a quoted Lua target after '='")
    return Ast.extern_decl(name.value, params, param_types, return_type, target.value, tok.line, tok.column)
}

// A `private`/`public` declaration: a property, a class member, or a method.
private parse_member(visibility: str): Node {
    if .cursor.match("STATIC") {
        if .cursor.match("LUA") {
            return .parse_lua_decl(visibility, true)
        }
        if .cursor.check("IDENTIFIER") and .looks_like_decl() {
            return .parse_method(visibility, true)
        }
        mut static_mut = .cursor.match("MUTABLE")
        return .parse_binding(visibility, static_mut, "Expected member name", true)
    }
    if .cursor.match("LUA") {
        return .parse_lua_decl(visibility, false)
    }
    if .cursor.check("IDENTIFIER") and .looks_like_decl() {
        return .parse_method(visibility, false)
    }
    mut mutable = .cursor.match("MUTABLE")
    return .parse_binding(visibility, mutable, "Expected property name", false)
}

private parse_static(): Node {
    if .cursor.match("LUA") {
        return .parse_lua_decl("", true)
    }
    if .cursor.check("IDENTIFIER") and .looks_like_decl() {
        return .parse_method("", true)
    }
    mut static_mut = .cursor.match("MUTABLE")
    return .parse_binding("", static_mut, "Expected member name after 'static'", true)
}

// An immutable binding must be initialised, except an instance property (a
// non-static visibility binding), which may be set later in the constructor.
private parse_binding(visibility: str, mutable: bool, name_err: str, is_static: bool): Node {
    mut name = .cursor.consume("IDENTIFIER", name_err)
    mut is_property = visibility != "" and not is_static
    mut attrs = ["name": name.value, "visibility": visibility, "mutable": mutable, "is_static": is_static, "line": name.line, "col": name.column]
    if .cursor.match("COLON") {
        attrs["type"] = .parse_type()
    }
    if .cursor.match("ASSIGN") {
        attrs["value"] = .exprs.expression()
    } else if not mutable and not is_property {
        .cursor.fail("Immutable binding '" ++ name.value ++ "' must be initialised: expected '='")
    }
    return Ast.node("VariableDecl", attrs)
}

// A bare assignment `<name> = <expr>` or compound `<name> += <expr>`; the latter
// desugars to a reassignment with a `BinaryExpr` value.
private parse_assignment(name_err: str): Node {
    mut name = .cursor.consume("IDENTIFIER", name_err)
    if .cursor.match("ASSIGN") {
        return .local_binding(name, .exprs.expression())
    }
    mut binop = .compound(.cursor.current_kind())
    if binop.is_some() {
        .cursor.advance()
        mut target = Ast.identifier(name.value, name.line, name.column)
        mut value = Ast.binary(binop.unwrap(), target, .exprs.expression(), name.line, name.column)
        return .local_binding(name, value)
    }
    .cursor.fail("Expected '=' or a compound assignment after '" ++ name.value ++ "'")
    return Ast.error_node()
}

private local_binding(name: Token, value: Node): Node {
    return Ast.node("VariableDecl", ["name": name.value, "value": value, "visibility": "", "mutable": false, "is_static": false, "line": name.line, "col": name.column])
}

private parse_method(visibility: str, is_static: bool): Node {
    mut name = .cursor.consume("IDENTIFIER", "Expected method name")
    mut type_params = .parse_type_params()
    .cursor.consume("LEFT_BRACKET", "Expected '(' after method name")
    mut param_types = []
    mut params = .parse_params(param_types)
    .cursor.consume("RIGHT_BRACKET", "Expected ')' after parameters")
    mut return_type = .parse_return_type()
    mut body = []
    if .cursor.match("ASSIGN") {
        mut expr = .exprs.expression()
        body = [Ast.node("ReturnStmt", ["value": expr, "line": expr.line(), "col": expr.col()])]
    } else {
        body = .parse_block("method body")
    }
    return Ast.function_decl(name.value, params, body, is_static, visibility, name.line, name.column, param_types, return_type, type_params)
}

// A `.`-prefixed param declares + assigns its field (parameter properties); the
// body braces are optional, so `constructor(.a, .b)` is a complete constructor.
// `@auto constructor(a, b)` makes every parameter a parameter-property; otherwise
// only `.`-prefixed params are. Each field param declares + assigns its field.
private parse_annotation(): Node {
    .cursor.consume("AT", "Expected '@'")
    mut name = .cursor.consume("IDENTIFIER", "Expected an annotation name after '@'")
    if name.value == "auto" {
        mut next_node = .parse_statement()
        next_node.set("annotation_class", "Auto")
        next_node.set("annotation_args", ["auto"])
        return next_node
    }
    if name.value == "platform" {
        .cursor.consume("LEFT_BRACKET", "Expected '(' after '@platform'")
        mut plat_tok = .cursor.consume("IDENTIFIER", "Expected platform name after '@platform('")
        .cursor.consume("RIGHT_BRACKET", "Expected ')' after platform name")
        mut next_node = .parse_statement()
        next_node.set("platform", plat_tok.value)
        return next_node
    }
    mut args = []
    if .cursor.match("LEFT_BRACKET") {
        loop {
            if .cursor.check("RIGHT_BRACKET") { break }
            mut arg = .cursor.consume("IDENTIFIER", "Expected annotation argument (identifier)")
            args.push(arg.value)
            if not .cursor.match("COMMA") { break }
        }
        .cursor.consume("RIGHT_BRACKET", "Expected ')' after annotation arguments")
    }
    mut next_node = .parse_statement()
    next_node.set("annotation_class", name.value)
    next_node.set("annotation_args", args)
    return next_node
}

private parse_constructor(tok: Token): Node {
    mut type_params = .parse_type_params()
    .cursor.consume("LEFT_BRACKET", "Expected '(' after 'constructor'")
    mut param_types = []
    mut field_params = []
    mut params = .parse_ctor_params(param_types, field_params)
    .cursor.consume("RIGHT_BRACKET", "Expected ')' after parameters")
    mut body = []
    for fp in field_params {
        body.push(.field_param_assign(fp))
    }
    if .cursor.check("BODY_START") {
        for stmt in .parse_block("constructor body") {
            body.push(stmt)
        }
    }
    mut node = Ast.constructor_decl(params, body, tok.line, tok.column, param_types, type_params)
    node.set("field_params", field_params)
    return node
}

// Like `parse_params`, but a leading `.` marks a parameter property: the param is
// also recorded as a field to declare and assign.
private parse_ctor_params(out_types: List<Node>, field_params: List<Map<str, dynamic>>): List<str> {
    mut params = []
    if not .cursor.check("RIGHT_BRACKET") {
        loop {
            mut is_field = .cursor.match("DOT")
            mut p = .cursor.consume("IDENTIFIER", "Expected parameter name")
            params.push(p.value)
            mut ty = .param_type(p)
            out_types.push(ty)
            if is_field {
                field_params.push(["name": p.value, "type": ty, "line": p.line, "col": p.column])
            }
            if not .cursor.match("COMMA") {
                break
            }
        }
    }
    return params
}

private field_param_assign<A>(fp: A): Node {
    mut name = fp.get("name").unwrap()
    mut l = fp.get("line").unwrap()
    mut c = fp.get("col").unwrap()
    return Ast.field_assign(Ast.member(Ast.self_expr(l, c), name, l, c), Ast.identifier(name, l, c), l, c)
}

// A comma-separated parameter list, the opening `(` consumed. Names are returned;
// each name's optional `: Type` (or `dynamic` when absent) is pushed onto
// `out_types`, kept aligned with the names.
private parse_params(out_types: List<Node>): List<str> {
    mut params = []
    if not .cursor.check("RIGHT_BRACKET") {
        loop {
            mut p = .cursor.consume("IDENTIFIER", "Expected parameter name")
            params.push(p.value)
            out_types.push(.param_type(p))
            if not .cursor.match("COMMA") {
                break
            }
        }
    }
    return params
}

private param_type(name_tok: Token): Node {
    if .cursor.match("COLON") {
        return .parse_type()
    }
    return Ast.type_name("dynamic", [], name_tok.line, name_tok.column)
}

private parse_return_type(): Node {
    if .cursor.match("COLON") {
        return .parse_type()
    }
    return Ast.type_name("dynamic", [], 0, 0)
}

private parse_typed_local(tok: Token): Node {
    mut name = .cursor.consume("IDENTIFIER", "Expected variable name")
    .cursor.consume("COLON", "Expected ':' before the type")
    mut ty = .parse_type()
    .cursor.consume("ASSIGN", "Expected '=' after the type annotation")
    mut value = .exprs.expression()
    return Ast.node("VariableDecl", ["name": name.value, "value": value, "type": ty, "visibility": "", "mutable": false, "is_static": false, "line": name.line, "col": name.column])
}

// Optional generic parameters `<T, U>` after an enum (or class) name.
private parse_type_params(): List<str> {
    mut params = []
    if .cursor.match("LESS") {
        loop {
            mut t = .cursor.consume("IDENTIFIER", "Expected a type parameter name")
            params.push(t.value)
            if not .cursor.match("COMMA") {
                break
            }
        }
        .cursor.consume("GREATER", "Expected '>' to close type parameters")
    }
    return params
}

// A type expression: a named/generic type `Name<...>`, or a function type
// `(T, ...) -> R`.
private parse_type(): Node {
    if .cursor.check("LEFT_BRACKET") {
        return .parse_type_fn()
    }
    mut name = .cursor.consume("IDENTIFIER", "Expected a type name")
    mut args = []
    if .cursor.match("LESS") {
        loop {
            args.push(.parse_type())
            if not .cursor.match("COMMA") {
                break
            }
        }
        .cursor.consume("GREATER", "Expected '>' to close type arguments")
    }
    return Ast.type_name(name.value, args, name.line, name.column)
}

private parse_type_fn(): Node {
    mut open = .cursor.consume("LEFT_BRACKET", "Expected '(' to open a function type")
    mut params = []
    if not .cursor.check("RIGHT_BRACKET") {
        loop {
            params.push(.parse_type())
            if not .cursor.match("COMMA") {
                break
            }
        }
    }
    .cursor.consume("RIGHT_BRACKET", "Expected ')' in the function type")
    .cursor.consume("ARROW", "Expected '->' in the function type")
    mut result = .parse_type()
    return Ast.type_fn(params, result, open.line, open.column)
}

// Lookahead: does the current `IDENTIFIER` begin a declaration `name(params) {`?
// True when a `(` follows (after an optional `<...>` generic header), its
// matching `)` is found, and a `{` or `:` (return type) comes next.
private looks_like_decl(): bool {
    mut i = .cursor.position() + 1
    if .cursor.token_at(i).kind == "LESS" {
        loop {
            mut k = .cursor.token_at(i).kind
            if k == "EOF" {
                return false
            }
            i = i + 1
            if k == "GREATER" {
                break
            }
        }
    }
    if .cursor.token_at(i).kind != "LEFT_BRACKET" {
        return false
    }
    mut depth = 0
    loop {
        mut kind = .cursor.token_at(i).kind
        if kind == "EOF" {
            return false
        } else if kind == "LEFT_BRACKET" {
            depth = depth + 1
        } else if kind == "RIGHT_BRACKET" {
            depth = depth - 1
            if depth == 0 {
                mut after = .cursor.token_at(i + 1).kind
                return after == "BODY_START" or after == "COLON"
            }
        }
        i = i + 1
    }
}

private parse_return(tok: Token): Node {
    mut attrs = ["line": tok.line, "col": tok.column]
    if not .cursor.check("BODY_END") and not .cursor.at_end() {
        attrs["value"] = .exprs.expression()
    }
    return Ast.node("ReturnStmt", attrs)
}

private parse_if(tok: Token): Node {
    mut clauses = [Ast.if_clause(.exprs.expression(), .parse_block("if body"))]
    mut attrs = ["clauses": clauses, "line": tok.line, "col": tok.column]
    loop {
        if not .cursor.match("ELSE") {
            break
        }
        if .cursor.match("IF") {
            clauses.push(Ast.if_clause(.exprs.expression(), .parse_block("else if body")))
        } else {
            attrs["else_body"] = .parse_block("else body")
            break
        }
    }
    return Ast.node("IfStmt", attrs)
}

private parse_while(tok: Token): Node {
    mut condition = .exprs.expression()
    mut body = .parse_block("while body")
    return Ast.while_stmt(condition, body, tok.line, tok.column)
}

private parse_loop(tok: Token): Node {
    return Ast.loop_stmt(.parse_block("loop body"), tok.line, tok.column)
}

private parse_break(tok: Token): Node {
    return Ast.break_stmt(tok.line, tok.column)
}

// `match` is a soft keyword (it stays an IDENTIFIER, so `cursor.match(...)` and a
// method named `match` keep working). It opens a match only at a statement head
// when what follows begins a scrutinee — not a call, assignment, or `.`/`[`.
private starts_match(): bool {
    mut nk = .cursor.peek_next().kind
    if nk == "LEFT_BRACKET" or nk == "ASSIGN" or nk == "DOT" or nk == "LSQUARE" {
        return false
    }
    return .compound(nk).is_none()
}

private parse_match(tok: Token): Node {
    mut scrutinee = .exprs.expression()
    mut open = .cursor.consume("BODY_START", "Expected '{' to open match body")
    mut arms = []
    loop {
        if .cursor.at_end() {
            .cursor.fail_at("Expected '}' to close match body", open.line, open.column, 1)
            break
        }
        if .cursor.check("BODY_END") {
            break
        }
        arms.push(.parse_match_arm())
    }
    .cursor.consume("BODY_END", "Expected '}' to close match body")
    return Ast.match_stmt(scrutinee, arms, tok.line, tok.column)
}

// One arm: a `_` catch-all; a bare PascalCase enum variant; or a value pattern
// expression compared against the scrutinee — then `=> { ... }`.
private parse_match_arm(): Node {
    mut tok = .cursor.current()
    if tok.kind == "IDENTIFIER" and tok.value == "_" {
        .cursor.advance()
        .cursor.consume("FAT_ARROW", "Expected '=>' after match pattern")
        return Ast.match_default(.parse_block("match arm body"))
    }
    if tok.kind == "IDENTIFIER" and .is_variant_name(tok.value) and .variant_pattern_ahead() {
        .cursor.advance()
        mut bindings = .parse_variant_bindings()
        .cursor.consume("FAT_ARROW", "Expected '=>' after match pattern")
        return Ast.match_variant(tok.value, bindings, .parse_block("match arm body"))
    }
    mut pattern = .exprs.expression()
    .cursor.consume("FAT_ARROW", "Expected '=>' after match pattern")
    return Ast.match_arm(pattern, .parse_block("match arm body"))
}

private variant_pattern_ahead(): bool {
    mut nk = .cursor.peek_next().kind
    return nk == "FAT_ARROW" or nk == "LEFT_BRACKET"
}

// The optional `( a, b )` binding names after a payload variant pattern.
private parse_variant_bindings(): List<str> {
    mut bindings = []
    if .cursor.match("LEFT_BRACKET") {
        if not .cursor.check("RIGHT_BRACKET") {
            loop {
                mut b = .cursor.consume("IDENTIFIER", "Expected a binding name in the variant pattern")
                bindings.push(b.value)
                if not .cursor.match("COMMA") {
                    break
                }
            }
        }
        .cursor.consume("RIGHT_BRACKET", "Expected ')' after the variant pattern bindings")
    }
    return bindings
}

// A PascalCase name (leading uppercase) marks an enum-variant pattern, distinct
// from a snake_case value/identifier pattern.
private is_variant_name(name: str): bool {
    mut first = Str.sub(name, 1, 1).unwrap_or("")
    return first >= "A" and first <= "Z"
}

// The two `for` forms: `for x in …` / `for k, v in …` versus the C-style
// `for <init>; <cond>; <step> { … }`, told apart by lookahead.
private parse_for(tok: Token): Node {
    if .looks_like_for_in() {
        return .parse_for_in(tok)
    }
    return .parse_for_c(tok)
}

private parse_for_in(tok: Token): Node {
    mut first = .cursor.consume("IDENTIFIER", "Expected a loop variable after 'for'")
    mut vars = [first.value]
    if .cursor.match("COMMA") {
        mut second = .cursor.consume("IDENTIFIER", "Expected a second loop variable after ','")
        vars.push(second.value)
    }
    .cursor.consume("IN", "Expected 'in' after the for-in loop variable(s)")
    mut iter = .exprs.expression()
    mut body = .parse_block("for body")
    return Ast.for_in(vars, iter, body, tok.line, tok.column)
}

private parse_for_c(tok: Token): Node {
    mut attrs = ["line": tok.line, "col": tok.column]
    if not .cursor.check("SEMICOLON") {
        attrs["init"] = .parse_assignment("Expected loop variable in for-init")
    }
    .cursor.consume("SEMICOLON", "Expected ';' after for-init")
    if not .cursor.check("SEMICOLON") {
        attrs["condition"] = .exprs.expression()
    }
    .cursor.consume("SEMICOLON", "Expected ';' after for-condition")
    if not .cursor.check("BODY_START") {
        attrs["step"] = .parse_assignment("Expected statement in for-step")
    }
    attrs["body"] = .parse_block("for body")
    return Ast.node("ForStmt", attrs)
}

private looks_like_for_in(): bool {
    if not .cursor.check("IDENTIFIER") {
        return false
    }
    mut k = .cursor.peek_next().kind
    return k == "IN" or k == "COMMA"
}

// A bare expression statement — or, when it is a field/index access followed by
// `=` (or a compound `+=`), an assignment to that target.
private parse_expr_statement(tok: Token): Node {
    mut expr = .exprs.expression()
    mut assignable = expr.kind == "MemberExpr" or expr.kind == "IndexExpr"
    if not assignable {
        return Ast.expression_stmt(expr, tok.line, tok.column)
    }
    if .cursor.match("ASSIGN") {
        return .make_assign(expr, .exprs.expression(), tok)
    }
    mut binop = .compound(.cursor.current_kind())
    if binop.is_some() {
        .cursor.advance()
        mut value = Ast.binary(binop.unwrap(), expr, .exprs.expression(), tok.line, tok.column)
        return .make_assign(expr, value, tok)
    }
    return Ast.expression_stmt(expr, tok.line, tok.column)
}

private make_assign(target: Node, value: Node, tok: Token): Node {
    if target.kind == "MemberExpr" {
        return Ast.field_assign(target, value, tok.line, tok.column)
    }
    return Ast.index_assign(target, value, tok.line, tok.column)
}

private compound(kind: str): Option<str> {
    return StmtParser.compounds.get(kind)
}
