// ExprParser — the expression grammar over a shared TokenCursor: precedence
// climbing for infix operators, prefix `not`, postfix call/member/index, then the
// primary atoms. The `precedences` table is the one place precedence is defined.
//
// Grammar methods are named `parse_*`: a method named like an `Ast` factory (e.g.
// `binary`) would be mis-compiled into a self-call, since a call's field name
// resolves against the current class before the receiver.

import frontend.parser.Ast
import frontend.parser.Node
import frontend.lexer.Token

private static precedences = [
    "OR": 1,
    "AND": 2,
    "EQ": 3,
    "NEQ": 3,
    "LESS": 3,
    "LESS_EQUAL": 3,
    "GREATER": 3,
    "GREATER_EQUAL": 3,
    "CONCAT": 4,
    "PLUS": 4,
    "MINUS": 4,
    "MULTIPLY": 5,
    "DIVIDE": 5,
    "MODULO": 5,
    "POWER": 6
]

@auto
constructor(cursor)

public expression(): Node {
    return .parse_binary(1)
}

// Left-associative precedence climbing: operators of precedence >= `min_prec`,
// recursing with `prec + 1` on the right so equal precedences group leftward.
private parse_binary(min_prec: int): Node {
    mut left = .parse_unary()
    loop {
        mut p = .precedence(.cursor.current_kind())
        if p.is_none() {
            break
        }
        mut prec = p.unwrap()
        if prec < min_prec {
            break
        }
        mut op = .cursor.advance()
        mut right = .parse_binary(prec + 1)
        left = Ast.binary(op.kind, left, right, op.line, op.column)
    }
    return left
}

private parse_unary(): Node {
    if .cursor.check("NOT") {
        mut op = .cursor.advance()
        mut operand = .parse_unary()
        return Ast.unary(op.kind, operand, op.line, op.column)
    }
    return .parse_call()
}

// Postfix chain: a primary followed by calls, member `.x` and index `[i]`. A `.x`
// or `[i]` opening a new line is a fresh statement, so it must share the previous
// token's line to chain.
private parse_call(): Node {
    mut expr = .parse_primary()
    loop {
        mut k = .cursor.current_kind()
        if k == "LEFT_BRACKET" {
            expr = .finish_call(expr)
        } else if k == "DOT" and .continues_line() {
            expr = .finish_member(expr)
        } else if k == "LSQUARE" and .continues_line() {
            expr = .finish_index(expr)
        } else {
            break
        }
    }
    return expr
}

private finish_call(callee): Node {
    mut paren = .cursor.advance()
    mut args = .parse_arguments()
    return Ast.call(callee, args, paren.line, paren.column)
}

private finish_member(object): Node {
    mut dot = .cursor.advance()
    mut field = .cursor.consume("IDENTIFIER", "Expected a field name after '.'")
    return Ast.member(object, field.value, dot.line, dot.column)
}

private finish_index(object): Node {
    mut bracket = .cursor.advance()
    mut index = .expression()
    .cursor.consume("RSQUARE", "Expected ']' after an index expression")
    return Ast.index(object, index, bracket.line, bracket.column)
}

private continues_line(): bool {
    return .cursor.previous().line == .cursor.current().line
}

// Call arguments after the opening `(`, up to and including the closing `)`.
private parse_arguments() {
    mut args = []
    if not .cursor.check("RIGHT_BRACKET") {
        loop {
            args.push(.expression())
            if not .cursor.match("COMMA") {
                break
            }
        }
    }
    .cursor.consume("RIGHT_BRACKET", "Expected ')' after arguments")
    return args
}

// The grammar atoms: literals, identifiers, `self`, leading-dot fields,
// collection literals, and parenthesised sub-expressions.
private parse_primary(): Node {
    mut tok = .cursor.current()
    match tok.kind {
        "LEFT_BRACKET" => {
            .cursor.advance()
            mut inner = .expression()
            .cursor.consume("RIGHT_BRACKET", "Expected ')' after expression")
            return inner
        }
        "NUMBER" => { .cursor.advance() return Ast.literal("number", tok.value, tok.line, tok.column) }
        "FLOAT" => { .cursor.advance() return Ast.literal("float", tok.value, tok.line, tok.column) }
        "STRING" => { .cursor.advance() return Ast.literal("string", tok.value, tok.line, tok.column) }
        "TRUE" => { .cursor.advance() return Ast.literal("boolean", true, tok.line, tok.column) }
        "FALSE" => { .cursor.advance() return Ast.literal("boolean", false, tok.line, tok.column) }
        "IDENTIFIER" => { .cursor.advance() return Ast.identifier(tok.value, tok.line, tok.column) }
        "SELF" => { .cursor.advance() return Ast.self_expr(tok.line, tok.column) }
        "LSQUARE" => { return .parse_collection() }
        "DOT" => {
            .cursor.advance()
            mut field = .cursor.consume("IDENTIFIER", "Expected a field name after '.'")
            return Ast.member(Ast.self_expr(tok.line, tok.column), field.value, tok.line, tok.column)
        }
        "EOF" => { .cursor.fail("Unexpected end of input") }
        _ => { .cursor.fail("Unexpected token '" ++ tok.value ++ "'") }
    }
    return Ast.literal("string", "", 0, 0)
}

// A list `[a, b]` or map `["k": v]` literal, the opening `[` current. Empty forms
// are `[]` and `[:]`; otherwise a `:` after the first element marks a map.
private parse_collection(): Node {
    mut open = .cursor.advance()
    if .cursor.check("RSQUARE") {
        .cursor.advance()
        return Ast.list([], open.line, open.column)
    }
    if .cursor.check("COLON") {
        .cursor.advance()
        .cursor.consume("RSQUARE", "Expected ']' to close empty map '[:]'")
        return Ast.map([], open.line, open.column)
    }

    mut first = .expression()
    if .cursor.match("COLON") {
        mut value = .expression()
        if .cursor.check("FOR") {
            return .parse_map_comp(first, value, open)
        }
        return .parse_map_rest(first, value, open)
    }
    if .cursor.check("FOR") {
        return .parse_list_comp(first, open)
    }
    return .parse_list_rest(first, open)
}

// `[elem for v in it (if c)]` and `[k: val for v in it (if c)]`. The clause is
// shared: it consumes `for <vars> in <iter> (if <cond>)` and the closing `]`,
// filling `attrs`.
private parse_list_comp(element: Node, open: Token): Node {
    mut attrs = ["element": element, "line": open.line, "col": open.column]
    .parse_comp_clause(attrs)
    return Ast.node("ListComp", attrs)
}

private parse_map_comp(key: Node, value: Node, open: Token): Node {
    mut attrs = ["key": key, "value": value, "line": open.line, "col": open.column]
    .parse_comp_clause(attrs)
    return Ast.node("MapComp", attrs)
}

private parse_comp_clause(attrs: Map<str, dynamic>) {
    .cursor.consume("FOR", "Expected 'for' in a comprehension")
    mut vars = [.cursor.consume("IDENTIFIER", "Expected a loop variable after 'for'").value]
    if .cursor.match("COMMA") {
        vars.push(.cursor.consume("IDENTIFIER", "Expected a second loop variable after ','").value)
    }
    .cursor.consume("IN", "Expected 'in' after the comprehension loop variable(s)")
    attrs["vars"] = vars
    attrs["iter"] = .expression()
    if .cursor.match("IF") {
        attrs["cond"] = .expression()
    }
    .cursor.consume("RSQUARE", "Expected ']' to close the comprehension")
}

private parse_map_rest(first: Node, value: Node, open: Token): Node {
    mut entries = [Ast.map_entry(first, value)]
    loop {
        if not .cursor.match("COMMA") {
            break
        }
        mut key = .expression()
        .cursor.consume("COLON", "Expected ':' between a map key and its value")
        entries.push(Ast.map_entry(key, .expression()))
    }
    .cursor.consume("RSQUARE", "Expected ']' to close the map literal")
    return Ast.map(entries, open.line, open.column)
}

private parse_list_rest(first, open): Node {
    mut elements = [first]
    loop {
        if not .cursor.match("COMMA") {
            break
        }
        elements.push(.expression())
    }
    .cursor.consume("RSQUARE", "Expected ']' to close the list literal")
    return Ast.list(elements, open.line, open.column)
}

private precedence(kind: str): Option<int> {
    return ExprParser.precedences.get(kind)
}
