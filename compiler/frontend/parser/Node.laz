// Node — a generic AST node: a `kind` tag plus a map of named attributes. Every
// parsed construct is one Node; an attribute is a scalar, another Node, or a list
// of Nodes, and an optional one is simply absent from the map.

public kind: str
private attrs: Map<str, dynamic>
@auto
constructor(kind: str, attrs: Map<str, dynamic>)

// Named `attr`, not `get`, since `get` is a reserved built-in collection method.
public attr(name: str) {
    return .attrs.get(name)
}

// A required attribute, unwrapped: an absent key is a malformed node (compiler
// bug), so the unwrap is intentional.
public child(name: str) {
    return .attrs.get(name).unwrap()
}

public line(): int {
    return .attrs.get("line").unwrap_or(0)
}

public col(): int {
    return .attrs.get("col").unwrap_or(0)
}

public set(name: str, value): unit {
    .attrs[name] = value
}

public summary(): str {
    mut named = .attrs.get("name")
    if named.is_some() {
        return .kind ++ " " ++ named.unwrap()
    }
    return .kind
}
