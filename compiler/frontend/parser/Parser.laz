// Parser — the façade over the parsing collaborators: a flat token list in, an
// AST out. A shared TokenCursor (navigation + errors) is handed to both the
// ExprParser and the StmtParser so they advance a single position.

import frontend.parser.TokenCursor
import frontend.parser.ExprParser
import frontend.parser.StmtParser

private stmts

constructor(tokens, source: str) {
    mut cursor = TokenCursor(tokens, source)
    mut exprs = ExprParser(cursor)
    .stmts = StmtParser(cursor, exprs)
}

public parse(): Node {
    return .stmts.parse_program()
}
