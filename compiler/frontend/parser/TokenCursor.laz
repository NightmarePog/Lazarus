// Walks the flat token list for the parsers. Reads past the end return an "EOF"
// sentinel token instead of an Option, so callers never guard for the end. The
// cursor also raises syntax errors, since it holds the source and position.

import std.Str
import Error
import frontend.lexer.Token

private tokens
private source: str
private pos: int

constructor(tokens, source: str) {
    .tokens = tokens
    .source = source
    .pos = 1
}

public position(): int {
    return .pos
}

// The token at an absolute index, or the EOF sentinel when out of range.
public token_at(i: int): Token {
    mut t = .tokens.get(i)
    if t.is_none() {
        return .eof()
    }
    return t.unwrap()
}

public current(): Token {
    return .token_at(.pos)
}

public current_kind(): str {
    return .current().kind
}

public peek_next(): Token {
    return .token_at(.pos + 1)
}

public previous(): Token {
    return .token_at(.pos - 1)
}

public at_end(): bool {
    return .current().kind == "EOF"
}

public check(kind: str): bool {
    return .current().kind == kind
}

// Consume and return the current token; raises at end of input.
public advance(): Token {
    if .at_end() {
        .fail("Unexpected end of input")
    }
    mut tok = .current()
    .pos = .pos + 1
    return tok
}

// Consume the current token when it has `kind`, reporting whether it did.
public match(kind: str): bool {
    if .check(kind) {
        .advance()
        return true
    }
    return false
}

// Consume a token of the expected kind, or raise `message` at its position.
public consume(kind: str, message: str): Token {
    if .check(kind) {
        return .advance()
    }
    .fail(message)
    return .eof()
}

// Raise a syntax error at the current token (else the last consumed one).
public fail(message: str) {
    mut t = .error_pos()
    mut span = Str.len(t.value).unwrap_or(1)
    if span < 1 {
        span = 1
    }
    .fail_at(message, t.line, t.column, span)
}

public fail_at(message: str, line: int, col: int, span: int) {
    Error("SyntaxError", message, line, col, .source, span).raise()
}

// The token an error points at: the current one, else the last consumed.
private error_pos(): Token {
    mut cur = .current()
    if cur.kind != "EOF" {
        return cur
    }
    mut prev = .previous()
    if prev.kind != "EOF" {
        return prev
    }
    return cur
}

private eof(): Token {
    return Token("EOF", "", 0, 0)
}
