// Char — character classification by ASCII byte code (Lazarus has no `%a`/`%d`
// patterns). Each predicate takes a one-char string; the empty string (EOF) has
// no byte, so `code_of` is None and `unwrap_or(0)` makes every predicate false.

@object
import std.Str

code_of(c: str): Option<int> {
    return Str.byte(c, 1)
}

is_digit(c: str): bool {
    mut code = Char.code_of(c).unwrap_or(0)
    return code >= 48 and code <= 57
}

is_alpha(c: str): bool {
    mut code = Char.code_of(c).unwrap_or(0)
    return (code >= 97 and code <= 122) or (code >= 65 and code <= 90)
}

is_underscore(c: str): bool {
    return Char.code_of(c).unwrap_or(0) == 95
}

is_ident_start(c: str): bool {
    return Char.is_alpha(c) or Char.is_underscore(c)
}

is_ident_char(c: str): bool {
    return Char.is_ident_start(c) or Char.is_digit(c)
}

is_space(c: str): bool {
    mut code = Char.code_of(c).unwrap_or(0)
    return code == 32 or (code >= 9 and code <= 13)
}

is_newline(c: str): bool {
    return Char.code_of(c).unwrap_or(0) == 10
}

is_quote(c: str): bool {
    return Char.code_of(c).unwrap_or(0) == 34
}
