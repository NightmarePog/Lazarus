// NodeFinder — find the deepest AST node at a given (line, col) position.
// Used by the LSP for hover, go-to-definition, and completion.
// Line and col are 1-indexed (Lazarus convention).
import frontend.parser.Node

// Walk the AST rooted at `root` and return the deepest node whose position
// satisfies `node.line() == line` and `0 < node.col() <= col`.
// Returns none when no node covers the position.
static lua find(root: Node, line: int, col: int): Option<Node> {
    local function is_node(v)
        return type(v) == 'table' and v.attrs ~= nil
    end
    local function search(node)
        if not is_node(node) then return nil end
        local best = nil
        for k, v in pairs(node.attrs.items) do
            if is_node(v) then
                local c = search(v)
                if c ~= nil then
                    if best == nil or Node.col(c) >= Node.col(best) then best = c end
                end
            elseif type(v) == 'table' and v.kind == 'list' then
                for _, item in ipairs(v.items) do
                    local c = search(item)
                    if c ~= nil then
                        if best == nil or Node.col(c) >= Node.col(best) then best = c end
                    end
                end
            end
        end
        if best ~= nil then return best end
        local nl = Node.line(node)
        local nc = Node.col(node)
        if nl == line and nc > 0 and nc <= col then return node end
        return nil
    end
    local result = search(root)
    if result == nil then return Option.none() end
    return Option.some(result)
}
