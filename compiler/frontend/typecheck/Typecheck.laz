// Typecheck — the type-checking pass. Runs after Schematic and before the
// optimizer, and only validates: types are erased, so it never touches the AST.
//
// It is gradual: an unannotated binding/function is `dynamic`, and any operation
// touching a `dynamic` value is allowed and produces `dynamic`. Where types are
// concrete the rules bite: arithmetic needs two numbers of the same kind (int and
// float never mix), `/` produces a float, a condition must be a bool, and an
// annotated binding/`return`/argument must match its declared type — all against
// the program-wide `classes` registry.

import std.Str
import Error
import frontend.parser.Node
import frontend.schematic.Scope
import frontend.typecheck.Type

private source: str
private class_name: str
private known_classes: Map<str, bool>
private enums: Map<str, List<str>>
private classes: Map<str, dynamic>
private variant_fields: Map<str, List<Node>>
private variant_owner: Map<str, str>
private enum_type_params: Map<str, List<str>>
private interfaces: Map<str, dynamic>
private type_vars: Map<str, bool>
private checking: Map<str, bool>
private iface_reason: str

constructor(source: str, class_name: str, imports: List<str>, enums: Map<str, List<str>>, classes: Map<str, dynamic>, variant_fields: Map<str, List<Node>>, variant_owner: Map<str, str>, enum_type_params: Map<str, List<str>>, interfaces: Map<str, dynamic>) {
    .source = source
    .class_name = class_name
    .known_classes = [:]
    for name in imports {
        .known_classes[name] = true
    }
    .known_classes[class_name] = true
    .enums = enums
    .classes = classes
    .variant_fields = variant_fields
    .variant_owner = variant_owner
    .enum_type_params = enum_type_params
    .interfaces = interfaces
    .type_vars = [:]
    .checking = [:]
    .iface_reason = ""
}

public check(program: Node): unit {
    .type_vars = .own_var_set()
    .type_block(program.child("body"), Scope.root(), Type.dynamic())
}

// The generic type variables of the current module's class/enum, in scope for
// every member: a generic class's `constructor<T>` params plus a generic enum's
// `<T>` header params.
private own_var_set(): Map<str, bool> {
    mut out = [:]
    for p in .own_type_params() {
        out[p] = true
    }
    return out
}

private own_type_params(): List<str> {
    mut out = []
    mut centry = .classes.get(.class_name)
    if centry.is_some() {
        for p in centry.unwrap().get("type_params").unwrap_or([]) {
            out.push(p)
        }
    }
    for p in .enum_type_params.get(.class_name).unwrap_or([]) {
        out.push(p)
    }
    return out
}

// ---- statements ----

private type_block(stmts: List<Node>, scope: Scope, ret: Type): unit {
    for stmt in stmts {
        .type_stmt(stmt, scope, ret)
    }
}

private type_stmt(stmt: Node, scope: Scope, ret: Type): unit {
    match stmt.kind {
        "VariableDecl" => { .type_variable(stmt, scope) }
        "FunctionDecl" => { .type_callable(stmt, scope) }
        "ConstructorDecl" => { .type_callable(stmt, scope) }
        "ReturnStmt" => { .type_return(stmt, scope, ret) }
        "ExpressionStmt" => { .type_expr(stmt.child("expression"), scope) }
        "FieldAssign" => { .type_expr(stmt.child("value"), scope) }
        "IndexAssign" => { .type_expr(stmt.child("value"), scope) }
        "IfStmt" => { .type_if(stmt, scope, ret) }
        "WhileStmt" => {
            .type_condition(stmt.child("condition"), scope)
            .type_block(stmt.child("body"), scope.child(), ret)
        }
        "LoopStmt" => { .type_block(stmt.child("body"), scope.child(), ret) }
        "ForStmt" => { .type_for(stmt, scope, ret) }
        "ForInStmt" => { .type_for_in(stmt, scope, ret) }
        "MatchStmt" => { .type_match(stmt, scope, ret) }
        _ => {}
    }
}

// A declaration records the binding's type (annotation, else inferred from the
// initialiser, else dynamic); an annotated initialiser is checked. A reassignment
// only re-types its value, so untyped code is never rejected here.
private type_variable(stmt: Node, scope: Scope): unit {
    mut value = stmt.attr("value")
    if stmt.attr("reassign").unwrap_or(false) {
        if value.is_some() {
            mut actual = .type_expr(value.unwrap(), scope)
            mut prior = scope.lookup(stmt.child("name"))
            if prior.is_some() {
                .expect(prior.unwrap(), actual, stmt, "reassignment")
            }
        }
        return
    }
    if value.is_some() and value.unwrap().kind == "FnExpr" {
        mut fn_node = value.unwrap()
        mut ptypes = [.resolve(pt) for pt in fn_node.child("param_types")]
        mut fn_ret = .return_type(fn_node)
        mut fn_type = Type.func(ptypes, fn_ret)
        mut fn_ann = stmt.attr("type")
        if fn_ann.is_some() {
            .expect(.resolve(fn_ann.unwrap()), fn_type, stmt, "binding")
            scope.declare(stmt.child("name"), .resolve(fn_ann.unwrap()))
        } else {
            scope.declare(stmt.child("name"), fn_type)
        }
        .type_fn_expr(fn_node, scope)
        return
    }
    mut actual = Type.dynamic()
    if value.is_some() {
        actual = .type_expr(value.unwrap(), scope)
    }
    mut t = actual
    mut ann = stmt.attr("type")
    if ann.is_some() {
        t = .resolve(ann.unwrap())
        if value.is_some() {
            .expect(t, actual, stmt, "binding")
        }
    }
    scope.declare(stmt.child("name"), t)
}

// A method/constructor body is checked with the class's type vars plus the
// callable's own generic params in scope, then the scope is restored.
private type_callable(stmt: Node, scope: Scope): unit {
    mut saved = .type_vars
    .type_vars = .callable_var_set(stmt)
    .check_annotations(stmt)
    mut ret = Type.unit()
    if stmt.kind == "FunctionDecl" {
        ret = .return_type(stmt)
    }
    mut inner = scope.child()
    .bind_params(stmt, inner)
    .type_block(stmt.child("body"), inner, ret)
    .type_vars = saved
}

private check_annotations(stmt: Node): unit {
    mut fname = stmt.attr("name").unwrap_or("constructor")
    for pt in stmt.attr("param_types").unwrap_or([]) {
        if pt.attr("inferred").unwrap_or(false) {
            .fail(pt, f"missing type annotation on a parameter of '{fname}' — use ': dynamic' to opt out")
        }
    }
    if stmt.kind == "FunctionDecl" {
        mut rt = stmt.attr("return_type")
        if rt.is_some() and rt.unwrap().attr("inferred").unwrap_or(false) {
            .fail(stmt, f"missing return type on '{fname}' — use ': dynamic' to opt out")
        }
    }
}

private callable_var_set(stmt: Node): Map<str, bool> {
    mut out = .own_var_set()
    for p in stmt.attr("type_params").unwrap_or([]) {
        out[p] = true
    }
    return out
}

private bind_params(stmt: Node, scope: Scope): unit {
    mut types = stmt.attr("param_types")
    mut i = 1
    for p in stmt.child("params") {
        mut t = Type.dynamic()
        if types.is_some() {
            t = .resolve(types.unwrap().get(i).unwrap())
        }
        scope.declare(p, t)
        i = i + 1
    }
}

private return_type(stmt: Node): Type {
    mut rt = stmt.attr("return_type")
    if rt.is_some() {
        return .resolve(rt.unwrap())
    }
    return Type.dynamic()
}

private type_return(stmt: Node, scope: Scope, ret: Type): unit {
    mut value = stmt.attr("value")
    if value.is_some() {
        .expect(ret, .type_expr(value.unwrap(), scope), stmt, "return")
    }
}

private type_if(stmt: Node, scope: Scope, ret: Type): unit {
    for clause in stmt.child("clauses") {
        .type_condition(clause.child("condition"), scope)
        .type_block(clause.child("body"), scope.child(), ret)
    }
    mut else_body = stmt.attr("else_body")
    if else_body.is_some() {
        .type_block(else_body.unwrap(), scope.child(), ret)
    }
}

private type_condition(node: Node, scope: Scope): unit {
    mut t = .type_expr(node, scope)
    if not t.is_dynamic() and t.kind != "bool" {
        .fail(node, "a condition must be a bool, found " ++ t.describe())
    }
}

private type_for(stmt: Node, scope: Scope, ret: Type): unit {
    mut inner = scope.child()
    mut init = stmt.attr("init")
    if init.is_some() {
        .type_stmt(init.unwrap(), inner, ret)
    }
    mut cond = stmt.attr("condition")
    if cond.is_some() {
        .type_condition(cond.unwrap(), inner)
    }
    mut step = stmt.attr("step")
    if step.is_some() {
        .type_stmt(step.unwrap(), inner, ret)
    }
    .type_block(stmt.child("body"), inner.child(), ret)
}

private type_for_in(stmt: Node, scope: Scope, ret: Type): unit {
    mut it = .type_expr(stmt.child("iter"), scope)
    mut inner = scope.child()
    .bind_loop_vars(stmt.child("vars"), it, inner)
    .type_block(stmt.child("body"), inner, ret)
}

// A loop variable over a `List<T>` binds `T` (a second var, the 0-based index, is
// `int`); over a `Map<K,V>` a single var binds `V`, two bind `K` then `V`.
private bind_loop_vars(vars: List<str>, it: Type, scope: Scope): unit {
    if it.kind == "class" and it.name == "List" {
        if vars.len() == 1 {
            scope.declare(vars.get(1).unwrap(), .type_arg(it, 1))
        } else {
            scope.declare(vars.get(1).unwrap(), Type.int())
            scope.declare(vars.get(2).unwrap(), .type_arg(it, 1))
        }
        return
    }
    if it.kind == "class" and it.name == "Map" {
        if vars.len() == 1 {
            scope.declare(vars.get(1).unwrap(), .type_arg(it, 2))
        } else {
            scope.declare(vars.get(1).unwrap(), .type_arg(it, 1))
            scope.declare(vars.get(2).unwrap(), .type_arg(it, 2))
        }
        return
    }
    for name in vars {
        scope.declare(name, Type.dynamic())
    }
}

private type_match(stmt: Node, scope: Scope, ret: Type): unit {
    .type_expr(stmt.child("scrutinee"), scope)
    for arm in stmt.child("arms") {
        mut arm_scope = scope.child()
        if arm.attr("is_variant").unwrap_or(false) {
            mut fields = .variant_fields.get(arm.child("variant")).unwrap_or([])
            mut i = 1
            for b in arm.child("bindings") {
                if b != "_" {
                    arm_scope.declare(b, .field_type(fields.get(i)))
                }
                i = i + 1
            }
        } else if not arm.attr("is_wildcard").unwrap_or(false) {
            if arm.attr("is_binding").unwrap_or(false) {
                arm_scope.declare(arm.child("pattern").child("name"), Type.dynamic())
            } else {
                .type_expr(arm.child("pattern"), scope)
            }
        }
        mut arm_guard = arm.attr("guard")
        if arm_guard.is_some() {
            .type_condition(arm_guard.unwrap(), arm_scope)
        }
        .type_block(arm.child("body"), arm_scope, ret)
    }
}

// ---- expressions ----

private type_expr(node: Node, scope: Scope): Type {
    match node.kind {
        "LiteralExpr" => { return .literal_type(node) }
        "IdentifierExpr" => { return .identifier_type(node.child("name"), scope) }
        "SelfExpr" => { return Type.class_of(.class_name, .self_args()) }
        "BinaryExpr" => { return .type_binary(node, scope) }
        "UnaryExpr" => {
            .type_expr(node.child("operand"), scope)
            return Type.bool()
        }
        "CallExpr" => { return .type_call(node, scope) }
        "MemberExpr" => { return .type_member(node, scope) }
        "IndexExpr" => { return .type_index(node, scope) }
        "ListExpr" => { return .type_list(node, scope) }
        "MapExpr" => { return .type_map(node, scope) }
        "ListComp" => { return .type_list_comp(node, scope) }
        "MapComp" => { return .type_map_comp(node, scope) }
        "InterpolatedString" => {
            mut parts = node.child("parts")
            mut i = 2
            while i <= parts.len() {
                .type_expr(parts.get(i).unwrap(), scope)
                i = i + 2
            }
            return Type.str()
        }
        "FnExpr" => { return .type_fn_expr(node, scope) }
        "PropagateExpr" => {
            .type_expr(node.child("inner"), scope)
            return Type.dynamic()
        }
        _ => {}
    }
    return Type.dynamic()
}

private type_fn_expr(node: Node, scope: Scope): Type {
    for pt in node.child("param_types") {
        if pt.attr("inferred").unwrap_or(false) {
            .fail(pt, "missing type annotation on a 'fn' parameter — use ': dynamic' to opt out")
        }
    }
    mut ptypes = [.resolve(pt) for pt in node.child("param_types")]
    mut ret = .return_type(node)
    mut inner = scope.child()
    mut i = 1
    for pname in node.child("params") {
        inner.declare(pname, ptypes.get(i).unwrap_or(Type.dynamic()))
        i = i + 1
    }
    .type_block(node.child("body"), inner, ret)
    return Type.func(ptypes, ret)
}

// A comprehension binds its loop variables from the iterable's element type, then
// the produced expression gives the result's element type(s).
private type_list_comp(node: Node, scope: Scope): Type {
    mut inner = .comp_scope(node, scope)
    return Type.class_of("List", [.type_expr(node.child("element"), inner)])
}

private type_map_comp(node: Node, scope: Scope): Type {
    mut inner = .comp_scope(node, scope)
    mut k = .type_expr(node.child("key"), inner)
    mut v = .type_expr(node.child("value"), inner)
    return Type.class_of("Map", [k, v])
}

private comp_scope(node: Node, scope: Scope): Scope {
    mut it = .type_expr(node.child("iter"), scope)
    mut inner = scope.child()
    .bind_loop_vars(node.child("vars"), it, inner)
    mut cond = node.attr("cond")
    if cond.is_some() {
        .type_expr(cond.unwrap(), inner)
    }
    return inner
}

// ---- built-in collections / Option / Result ----

private is_builtin_name(name: str): bool {
    return name == "Option" or name == "Result" or name == "List" or name == "Map"
}

// A built-in generic instance (List<int>, Option<str>, …). Accepts both `class`
// and `enum` kinds so that variant constructions (`Some(v)` → enum) still
// dispatch through the builtin path alongside declared types (class).
private is_builtin_type(t: Type): bool {
    return (t.kind == "class" or t.kind == "enum") and .is_builtin_name(t.name)
}

// The i-th (1-based) type argument of a generic instance, or dynamic.
private type_arg(t: Type, i: int): Type {
    return t.params.get(i).unwrap_or(Type.dynamic())
}

private opt_of(t: Type): Type {
    return Type.class_of("Option", [t])
}

// Lenient element unification: agreeing concrete types keep that type; a `dynamic`
// side defers; a genuine mismatch falls back to `dynamic` (no error), so a mixed
// literal is simply `List<dynamic>` / a record map `Map<…, dynamic>`.
private unify_elem(acc: Type, next: Type): Type {
    if next.is_dynamic() {
        return acc
    }
    if acc.is_dynamic() {
        return next
    }
    if not acc.equals(next) {
        return Type.dynamic()
    }
    return acc
}

private type_list(node: Node, scope: Scope): Type {
    mut elem = Type.dynamic()
    for e in node.child("elements") {
        elem = .unify_elem(elem, .type_expr(e, scope))
    }
    return Type.class_of("List", [elem])
}

private type_map(node: Node, scope: Scope): Type {
    mut kt = Type.dynamic()
    mut vt = Type.dynamic()
    for entry in node.child("entries") {
        kt = .unify_elem(kt, .type_expr(entry.child("key"), scope))
        vt = .unify_elem(vt, .type_expr(entry.child("value"), scope))
    }
    return Type.class_of("Map", [kt, vt])
}

private type_index(node: Node, scope: Scope): Type {
    mut obj = .type_expr(node.child("object"), scope)
    .type_expr(node.child("index"), scope)
    if obj.kind == "class" and obj.name == "List" {
        return .type_arg(obj, 1)
    }
    if obj.kind == "class" and obj.name == "Map" {
        return .type_arg(obj, 2)
    }
    return Type.dynamic()
}

// `Option.some(v)` / `Result.ok(v)` carry their element type; `none`/`err` leave
// it unbound (dynamic).
private type_builtin_ctor(ns: str, field: str, args: List<Node>, scope: Scope): Type {
    mut elem = Type.dynamic()
    for arg in args {
        mut at = .type_expr(arg, scope)
        if elem.is_dynamic() {
            elem = at
        }
    }
    if ns == "Option" {
        if field == "some" {
            return .opt_of(elem)
        }
        return .opt_of(Type.dynamic())
    }
    if field == "ok" {
        return Type.class_of("Result", [elem])
    }
    return Type.class_of("Result", [Type.dynamic()])
}

// Result types for the built-in methods of List/Map/Option/Result.
private builtin_method(recv: Type, method: str, args: List<Node>, scope: Scope): Type {
    for arg in args {
        .type_expr(arg, scope)
    }
    mut a = .type_arg(recv, 1)
    if recv.name == "List" {
        if method == "get" or method == "pop" {
            return .opt_of(a)
        }
        if method == "len" {
            return Type.int()
        }
        if method == "has" {
            return Type.bool()
        }
        return Type.unit()
    }
    if recv.name == "Map" {
        if method == "get" {
            return .opt_of(.type_arg(recv, 2))
        }
        if method == "has" {
            return Type.bool()
        }
        if method == "len" {
            return Type.int()
        }
        return Type.unit()
    }
    if recv.name == "Option" {
        if method == "unwrap" or method == "unwrap_or" {
            return a
        }
        return Type.bool()
    }
    if method == "unwrap" or method == "unwrap_or" {
        return a
    }
    if method == "error" {
        return Type.str()
    }
    return Type.bool()
}

private literal_type(node: Node): Type {
    mut lk = node.child("lit_kind")
    if lk == "number" {
        return Type.int()
    }
    if lk == "float" {
        return Type.float()
    }
    if lk == "string" {
        return Type.str()
    }
    if lk == "boolean" {
        return Type.bool()
    }
    return Type.dynamic()
}

private type_binary(node: Node, scope: Scope): Type {
    mut lt = .type_expr(node.child("left"), scope)
    mut rt = .type_expr(node.child("right"), scope)
    mut op = node.child("op")
    if .is_arith(op) {
        return .arith_type(node, op, lt, rt)
    }
    if op == "CONCAT" {
        return .concat_type(node, lt, rt)
    }
    if op == "EQ" or op == "NEQ" {
        return .equality_type(node, lt, rt)
    }
    if .is_ordering(op) {
        return .ordering_type(node, lt, rt)
    }
    return Type.bool()
}

private is_arith(op: str): bool {
    return op == "PLUS" or op == "MINUS" or op == "MULTIPLY" or op == "DIVIDE" or op == "MODULO" or op == "POWER"
}

private is_ordering(op: str): bool {
    return op == "LESS" or op == "LESS_EQUAL" or op == "GREATER" or op == "GREATER_EQUAL"
}

// `++` joins two strings; either side may be `dynamic`, but a concrete non-string
// must be converted first.
private concat_type(node: Node, lt: Type, rt: Type): Type {
    if not .str_or_dynamic(lt) or not .str_or_dynamic(rt) {
        .fail(node, "++ joins strings, found " ++ lt.describe() ++ " and " ++ rt.describe() ++ "; convert explicitly")
    }
    return Type.str()
}

private str_or_dynamic(t: Type): bool {
    return t.is_dynamic() or t.kind == "str"
}

// `==`/`!=` compare two values of the same type; a `dynamic` side defers.
private equality_type(node: Node, lt: Type, rt: Type): Type {
    if not lt.is_dynamic() and not rt.is_dynamic() and not lt.equals(rt) {
        .fail(node, "cannot compare " ++ lt.describe() ++ " and " ++ rt.describe() ++ " for equality")
    }
    return Type.bool()
}

// `< > <= >=` order two numbers of the same kind; a `dynamic` side defers.
private ordering_type(node: Node, lt: Type, rt: Type): Type {
    if lt.is_dynamic() or rt.is_dynamic() {
        return Type.bool()
    }
    if not lt.is_numeric() or not rt.is_numeric() {
        .fail(node, "ordering needs numbers, found " ++ lt.describe() ++ " and " ++ rt.describe())
    }
    if not lt.equals(rt) {
        .fail(node, "cannot order " ++ lt.describe() ++ " against " ++ rt.describe() ++ "; convert explicitly")
    }
    return Type.bool()
}

private arith_type(node: Node, op: str, lt: Type, rt: Type): Type {
    if lt.is_dynamic() or rt.is_dynamic() {
        return Type.dynamic()
    }
    if not lt.is_numeric() or not rt.is_numeric() {
        .fail(node, "arithmetic needs numbers, found " ++ lt.describe() ++ " and " ++ rt.describe())
    }
    if not lt.equals(rt) {
        .fail(node, "cannot mix " ++ lt.describe() ++ " and " ++ rt.describe() ++ " in arithmetic; convert explicitly")
    }
    if op == "DIVIDE" {
        return Type.float()
    }
    return lt
}

// ---- calls & members ----

// An identifier is its bound type; a bare nullary variant (`None`) is its enum; a
// bare class name used as a static receiver is the class; otherwise dynamic.
private identifier_type(name: str, scope: Scope): Type {
    mut found = scope.lookup(name)
    if found.is_some() {
        return found.unwrap()
    }
    if .variant_owner.has(name) {
        return .enum_instance(.variant_owner.get(name).unwrap(), [:])
    }
    if .classes.has(name) {
        return Type.class_of(name, [])
    }
    return Type.dynamic()
}

// A call is a bare variant construction (`Some(5)`), object construction
// (`Class(args)`), a method call (`obj.m()`), or otherwise untyped.
private type_call(node: Node, scope: Scope): Type {
    mut callee = node.child("callee")
    mut args = node.child("args")
    if callee.kind == "MemberExpr" {
        mut obj = callee.child("object")
        if obj.kind == "IdentifierExpr" and (obj.child("name") == "Option" or obj.child("name") == "Result") {
            return .type_builtin_ctor(obj.child("name"), callee.child("field"), args, scope)
        }
        return .type_method_call(callee, args, scope, node)
    }
    if callee.kind == "IdentifierExpr" {
        mut name = callee.child("name")
        if .variant_owner.has(name) {
            return .type_variant(name, args, scope, node)
        }
        if not scope.lookup(name).is_some() and .interfaces.has(name) {
            .fail(callee, "cannot construct interface '" ++ name ++ "'")
        }
        if not scope.lookup(name).is_some() and .classes.has(name) {
            return .type_construction(name, args, scope, node)
        }
    }
    if .is_labeled(args) {
        .fail(node, "labeled arguments can only be used with a known method or constructor")
    }
    mut callee_type = .type_expr(callee, scope)
    if callee_type.kind == "fn" {
        return .type_fn_call(callee_type, args, scope, node)
    }
    for arg in args {
        .type_expr(arg, scope)
    }
    return Type.dynamic()
}

private type_fn_call(fn_type: Type, args: List<Node>, scope: Scope, node: Node): Type {
    mut params = fn_type.params
    if args.len() != params.len() {
        .fail(node, "wrong number of arguments: expected " ++ .count(params.len()) ++ ", found " ++ .count(args.len()))
    }
    mut i = 1
    for arg in args {
        mut expected = params.get(i).unwrap_or(Type.dynamic())
        mut actual = .type_expr(arg, scope)
        .expect(expected, actual, arg, "argument")
        i = i + 1
    }
    return fn_type.result.unwrap_or(Type.dynamic())
}

// Object construction: unify the constructor's params (in the class's var scope)
// against the args, then read the class's type args off the solution.
private type_construction(name: str, args: List<Node>, scope: Scope, node: Node): Type {
    mut ctor = .classes.get(name).unwrap().get("ctor").unwrap()
    mut call_args = args
    if .is_labeled(args) {
        mut ctor_names = .classes.get(name).unwrap().get("ctor_names").unwrap_or([])
        call_args = .resolve_labeled(ctor, ctor_names, args, node)
        node.set("args", call_args)
    }
    mut subst = [:]
    if ctor == 0 {
        for arg in call_args {
            .type_expr(arg, scope)
        }
    } else {
        .infer_and_check(ctor, .class_var_set(name), call_args, scope, node, subst)
    }
    return .class_instance(name, subst)
}

// Bare variant construction `Some(args)`: unify the variant's payload types
// against the args; the result is the owner enum.
private type_variant(name: str, args: List<Node>, scope: Scope, node: Node): Type {
    mut owner = .variant_owner.get(name).unwrap()
    mut subst = [:]
    .infer_and_check(.variant_fields.get(name).unwrap_or([]), .enum_var_set(owner), args, scope, node, subst)
    return .enum_instance(owner, subst)
}

private type_method_call(member: Node, args: List<Node>, scope: Scope, call: Node): Type {
    mut object = member.child("object")
    mut method = member.child("field")
    mut recv = .receiver_type(object, scope)
    if .is_builtin_type(recv) {
        mut class_entry = .classes.get(recv.name)
        if class_entry.is_some() {
            mut sig = class_entry.unwrap().get("methods").unwrap().get(method)
            if sig.is_some() and sig.unwrap().get("is_static").unwrap_or(false) {
                call.set("dispatch_class", recv.name)
                mut full_args = [object]
                for arg in args { full_args.push(arg) }
                return .type_method_sig(recv.name, recv, sig.unwrap(), full_args, scope, call)
            }
        }
        return .builtin_method(recv, method, args, scope)
    }
    if recv.kind == "iface" {
        return .iface_method(recv, method, args, scope, call)
    }
    mut cls = .class_name_of(recv)
    if cls == "" {
        for arg in args {
            .type_expr(arg, scope)
        }
        return Type.dynamic()
    }
    mut sig = .classes.get(cls).unwrap().get("methods").unwrap().get(method)
    if not sig.is_some() {
        mut fields = .classes.get(cls).unwrap().get("fields").unwrap()
        mut field_opt = fields.get(method)
        if field_opt.is_some() {
            mut field_node_opt = field_opt.unwrap()
            if field_node_opt.is_some() {
                mut ft = .substitute(.resolve_with(field_node_opt.unwrap(), .class_var_set(cls)), .receiver_subst(cls, recv))
                if ft.kind == "fn" {
                    return .type_fn_call(ft, args, scope, call)
                }
            }
        }
        if .static_receiver(object, scope) {
            for arg in args {
                .type_expr(arg, scope)
            }
            return Type.dynamic()
        }
        .fail(member, "no method '" ++ method ++ "' on " ++ cls)
    }
    return .type_method_sig(cls, recv, sig.unwrap(), args, scope, call)
}

// A method call: the receiver's type args pre-bind the class params, the method's
// own `<U>` are inferred from the call args, and the result is substituted through.
private type_method_sig(cls: str, recv: Type, sig: Map<str, dynamic>, args: List<Node>, scope: Scope, call: Node): Type {
    mut call_args = args
    if .is_labeled(args) {
        mut names = sig.get("param_names").unwrap_or([])
        call_args = .resolve_labeled(sig.get("params").unwrap(), names, args, call)
        call.set("args", call_args)
    }
    mut vars = .method_var_set(cls, sig)
    mut subst = .receiver_subst(cls, recv)
    .infer_and_check(sig.get("params").unwrap(), vars, call_args, scope, call, subst)
    mut result = sig.get("result").unwrap_or(0)
    if result == 0 {
        return Type.dynamic()
    }
    return .substitute(.resolve_with(result, vars), subst)
}

// A member read is a field's declared type, with the receiver's type args
// substituted in (so `value: T` on a `Box<int>` reads as `int`). An unknown member
// on an instance receiver is an error; a method-as-value or static member is
// dynamic.
private type_member(node: Node, scope: Scope): Type {
    mut object = node.child("object")
    mut field = node.child("field")
    mut recv = .receiver_type(object, scope)
    mut cls = .class_name_of(recv)
    if cls == "" {
        return Type.dynamic()
    }
    mut entry = .classes.get(cls).unwrap()
    mut ft = entry.get("fields").unwrap().get(field)
    if ft.is_some() {
        mut fnode = ft.unwrap()
        if fnode.is_none() {
            return Type.dynamic()
        }
        return .substitute(.resolve_with(fnode.unwrap(), .class_var_set(cls)), .receiver_subst(cls, recv))
    }
    if entry.get("methods").unwrap().has(field) {
        return Type.dynamic()
    }
    if .static_receiver(object, scope) {
        return Type.dynamic()
    }
    .fail(node, "no field '" ++ field ++ "' on " ++ cls)
}

// The receiver's type: the current class (with its own params as vars) for
// `self`/`.x`, a bare class name for a static access, the value's type, or dynamic.
private receiver_type(object: Node, scope: Scope): Type {
    if object.kind == "SelfExpr" {
        return Type.class_of(.class_name, .self_args())
    }
    if object.kind == "IdentifierExpr" {
        mut found = scope.lookup(object.child("name"))
        if found.is_some() {
            return found.unwrap()
        }
        if .classes.has(object.child("name")) {
            return Type.class_of(object.child("name"), [])
        }
        return Type.dynamic()
    }
    return .type_expr(object, scope)
}

private class_name_of(t: Type): str {
    if t.kind == "class" or t.kind == "enum" {
        return t.name
    }
    return ""
}

// Whether a receiver is a bare class name (a static access like `Other.x`), as
// opposed to `self` or a value typed as a class — used to stay lenient about
// members the instance-side registry does not track.
private static_receiver(object: Node, scope: Scope): bool {
    if object.kind != "IdentifierExpr" {
        return false
    }
    return not scope.lookup(object.child("name")).is_some() and .classes.has(object.child("name"))
}

private is_labeled(args: List<Node>): bool {
    mut first = args.get(1)
    if first.is_none() {
        return false
    }
    return first.unwrap().kind == "LabeledArg"
}

// Reorder labeled args to match declaration order, fill nil for omitted defaults.
// Mutates nothing — returns the resolved positional list.
private resolve_labeled(param_nodes: List<Node>, param_names: List<str>, args: List<Node>, node: Node): List<Node> {
    mut named = [:]
    for arg in args {
        mut label = arg.child("name")
        if named.has(label) {
            .fail(node, "duplicate labeled argument '" ++ label ++ "'")
        }
        named[label] = arg.child("value")
    }
    for label, _ in named {
        mut found = false
        for pname in param_names {
            if pname == label {
                found = true
            }
        }
        if not found {
            .fail(node, "unknown labeled argument '" ++ label ++ "'")
        }
    }
    mut resolved = []
    mut i = 1
    for pname in param_names {
        if named.has(pname) {
            resolved.push(named.get(pname).unwrap())
        } else {
            if not param_nodes.get(i).unwrap().attr("default").is_some() {
                .fail(node, "missing required argument '" ++ pname ++ "'")
            }
            resolved.push(Node("LiteralExpr", ["lit_kind": "nil", "value": 0, "line": node.line(), "col": node.col()]))
        }
        i = i + 1
    }
    return resolved
}

// Check args against parameter type nodes (resolved in the callee's var scope):
// counts must match (or trailing params have defaults), each param is unified
// against its arg to solve type vars, then each concrete (substituted) param
// must accept its arg.
private infer_and_check(param_nodes: List<Node>, callee_vars: Map<str, bool>, args: List<Node>, scope: Scope, node: Node, subst: Map<str, Type>): unit {
    if args.len() > param_nodes.len() {
        .fail(node, "wrong number of arguments: expected " ++ .count(param_nodes.len()) ++ ", found " ++ .count(args.len()))
    }
    if args.len() < param_nodes.len() {
        mut i = args.len() + 1
        while i <= param_nodes.len() {
            if not param_nodes.get(i).unwrap().attr("default").is_some() {
                .fail(node, "wrong number of arguments: expected " ++ .count(param_nodes.len()) ++ ", found " ++ .count(args.len()) ++ " (parameter " ++ .count(i) ++ " has no default)")
            }
            i = i + 1
        }
    }
    mut ptypes = []
    mut atypes = []
    mut i = 1
    for arg in args {
        mut pt = .resolve_with(param_nodes.get(i).unwrap(), callee_vars)
        mut at = .type_expr(arg, scope)
        .unify(pt, at, subst)
        ptypes.push(pt)
        atypes.push(at)
        i = i + 1
    }
    mut j = 1
    for arg in args {
        .expect(.substitute(ptypes.get(j).unwrap(), subst), atypes.get(j).unwrap(), arg, "argument")
        j = j + 1
    }
}

private count(n: int): str {
    return Str.format("%d", n).unwrap_or("?")
}

// Resolve an optional field/result type node — an absent or unannotated (0) slot
// is `dynamic`.
private field_type(opt: Option<Node>): Type {
    if not opt.is_some() {
        return Type.dynamic()
    }
    return .resolve(opt.unwrap())
}

// ---- generics ----

// The current class's own type params as type-variable arguments, so `self` is
// `Box<T>` (not bare `Box`) and members typed in `T` flow.
private self_args(): List<Type> {
    return [Type.var(p) for p in .own_type_params()]
}

private class_instance(name: str, subst: Map<str, Type>): Type {
    return Type.class_of(name, .solved_args(.class_params(name), subst))
}

private enum_instance(owner: str, subst: Map<str, Type>): Type {
    return Type.enum_of(owner, .solved_args(.enum_type_params.get(owner).unwrap_or([]), subst))
}

// Read a declaration's type args off an inference solution: each param maps to its
// solved type, or `dynamic` when inference left it unbound.
private solved_args(params: List<str>, subst: Map<str, Type>): List<Type> {
    return [.subst_lookup(subst, p) for p in params]
}

private subst_lookup(subst: Map<str, Type>, name: str): Type {
    mut v = subst.get(name)
    if v.is_some() {
        return v.unwrap()
    }
    return Type.dynamic()
}

private class_params(name: str): List<str> {
    mut centry = .classes.get(name)
    if centry.is_some() {
        return centry.unwrap().get("type_params").unwrap_or([])
    }
    return []
}

private class_var_set(name: str): Map<str, bool> {
    mut out = [:]
    for p in .class_params(name) {
        out[p] = true
    }
    return out
}

private enum_var_set(name: str): Map<str, bool> {
    mut out = [:]
    for p in .enum_type_params.get(name).unwrap_or([]) {
        out[p] = true
    }
    return out
}

private method_var_set(cls: str, sig: Map<str, dynamic>): Map<str, bool> {
    mut out = .class_var_set(cls)
    for p in sig.get("type_params").unwrap_or([]) {
        out[p] = true
    }
    return out
}

// Pre-bind a class's type params to the receiver's concrete type args, so a
// method/field typed in `T` reads at the receiver's instantiation. A param the
// receiver does not carry — a bare class name in a static call like
// `Option.some(5)` — is left unbound, so the call's arguments can still solve it
// (`T` = int) instead of collapsing to `dynamic`.
private receiver_subst(cls: str, recv: Type): Map<str, Type> {
    mut subst = [:]
    mut i = 1
    for p in .class_params(cls) {
        mut arg = recv.params.get(i)
        if arg.is_some() {
            subst[p] = arg.unwrap()
        }
        i = i + 1
    }
    return subst
}

// Resolve a type node with a specific set of type vars in scope (the callee's, not
// the caller's), restoring afterward.
private resolve_with(node: Node, vars: Map<str, bool>): Type {
    mut saved = .type_vars
    .type_vars = vars
    mut r = .resolve(node)
    .type_vars = saved
    return r
}

// Solve type vars by matching a declared param type against a synthesized arg type.
// Never fails: it only records solutions (first binding wins); a `dynamic` side or
// a head mismatch yields no constraint.
private unify(param: Type, arg: Type, subst: Map<str, Type>): unit {
    if param.kind == "var" {
        if not subst.has(param.name) {
            subst[param.name] = arg
        }
        return
    }
    if param.is_dynamic() or arg.is_dynamic() {
        return
    }
    if param.kind == arg.kind and (param.kind == "class" or param.kind == "enum") and param.name == arg.name {
        mut i = 1
        for p in param.params {
            .unify(p, arg.params.get(i).unwrap_or(Type.dynamic()), subst)
            i = i + 1
        }
    }
}

// Replace type vars with their solutions (unbound → dynamic), recursing into
// function and generic-instance arguments.
private substitute(t: Type, subst: Map<str, Type>): Type {
    if t.kind == "var" {
        return .subst_lookup(subst, t.name)
    }
    if t.kind == "fn" {
        return Type.func([.substitute(p, subst) for p in t.params], .substitute(t.result.unwrap(), subst))
    }
    if (t.kind == "class" or t.kind == "enum") and t.params.len() > 0 {
        return Type(t.kind, t.name, [.substitute(a, subst) for a in t.params], t.result)
    }
    return t
}

// ---- helpers ----

// Turn a parsed type annotation node into a resolved Type. A name in scope as a
// type variable resolves to that `var`; a known class/enum to a (possibly generic)
// instance; anything else to `dynamic`.
private resolve(t: Node): Type {
    if t.kind == "TypeUnion" {
        return Type.union([.resolve(m) for m in t.child("members")])
    }
    if t.kind == "TypeFn" {
        return Type.func([.resolve(p) for p in t.child("params")], .resolve(t.child("result")))
    }
    mut name = t.child("name")
    match name {
        "int" => { return Type.int() }
        "float" => { return Type.float() }
        "bool" => { return Type.bool() }
        "str" => { return Type.str() }
        "unit" => { return Type.unit() }
        "dynamic" => { return Type.dynamic() }
        _ => {}
    }
    if .type_vars.has(name) {
        return Type.var(name)
    }
    if .is_builtin_name(name) {
        return Type.class_of(name, .resolve_args(t, name))
    }
    if .enums.has(name) {
        return Type.enum_of(name, .resolve_args(t, name))
    }
    if .interfaces.has(name) {
        return Type.iface_of(name, .resolve_args(t, name))
    }
    if .known_classes.has(name) or .classes.has(name) {
        return Type.class_of(name, .resolve_args(t, name))
    }
    return Type.dynamic()
}

// Resolve a type node's explicit `<...>` arguments. A bare name (no args) yields
// `[]` (lenient); when args ARE written, their count must match the declaration.
private resolve_args(t: Node, name: str): List<Type> {
    mut nodes = t.child("args")
    if nodes.len() == 0 {
        return []
    }
    mut declared = .declared_arity(name)
    if declared >= 0 and nodes.len() != declared {
        .fail(t, name ++ " expects " ++ .count(declared) ++ " type argument(s), found " ++ .count(nodes.len()))
    }
    return [.resolve(a) for a in nodes]
}

private declared_arity(name: str): int {
    if name == "Option" or name == "Result" or name == "List" {
        return 1
    }
    if name == "Map" {
        return 2
    }
    if .enum_type_params.has(name) {
        return .enum_type_params.get(name).unwrap().len()
    }
    if .interfaces.has(name) {
        return .interfaces.get(name).unwrap().get("type_params").unwrap_or([]).len()
    }
    mut centry = .classes.get(name)
    if centry.is_some() {
        return centry.unwrap().get("type_params").unwrap_or([]).len()
    }
    return 0 - 1
}

private expect(expected: Type, actual: Type, node: Node, what: str): unit {
    if not .compatible(expected, actual) {
        if expected.kind == "iface" and .iface_reason != "" {
            .fail(node, actual.describe() ++ " does not satisfy " ++ expected.describe() ++ ": " ++ .iface_reason)
        }
        .fail(node, "type mismatch in " ++ what ++ ": expected " ++ expected.describe() ++ ", found " ++ actual.describe())
    }
}

// Assignability. `dynamic` and unsolved type variables defer. Two concrete
// class/enum types must share a name and have compatible type args position-wise —
// but a missing/`dynamic` arg on either side is compatible, so `Result<int>`
// clashes with `Result<str>` while bare `Result` matches anything.
private compatible(expected: Type, actual: Type): bool {
    if expected.is_dynamic() or actual.is_dynamic() {
        return true
    }
    if expected.kind == "var" or actual.kind == "var" {
        return true
    }
    // Union on expected side: actual fits if it fits any member.
    if expected.kind == "union" {
        for m in expected.params {
            if .compatible(m, actual) {
                return true
            }
        }
        return false
    }
    // Union on actual side: all members must fit expected.
    if actual.kind == "union" {
        for m in actual.params {
            if not .compatible(expected, m) {
                return false
            }
        }
        return true
    }
    if expected.kind == "iface" {
        return .satisfies(expected, actual)
    }
    if expected.kind == "fn" {
        if actual.kind != "fn" {
            return false
        }
        if expected.params.len() != actual.params.len() {
            return false
        }
        mut i = 1
        for p in expected.params {
            if not .compatible(p, actual.params.get(i).unwrap_or(Type.dynamic())) {
                return false
            }
            i = i + 1
        }
        return .compatible(expected.result.unwrap_or(Type.dynamic()), actual.result.unwrap_or(Type.dynamic()))
    }
    // class and enum with the same name are compatible: Option<T> is declared as
    // class (is_builtin_name) but variant constructions (Some(v)) yield enum kind.
    if (expected.kind == "class" or expected.kind == "enum") and
       (actual.kind == "class" or actual.kind == "enum") and
       expected.name == actual.name {
        return .args_compatible(expected.params, actual.params)
    }
    if not expected.equals(actual) {
        return false
    }
    if expected.kind == "class" or expected.kind == "enum" {
        return .args_compatible(expected.params, actual.params)
    }
    return true
}

private args_compatible(a: List<Type>, b: List<Type>): bool {
    mut n = a.len()
    if b.len() > n {
        n = b.len()
    }
    mut i = 1
    loop {
        if i > n {
            break
        }
        if not .compatible(a.get(i).unwrap_or(Type.dynamic()), b.get(i).unwrap_or(Type.dynamic())) {
            return false
        }
        i = i + 1
    }
    return true
}

// ---- interface conformance (interface-directed structural subtyping) ----

// Does `actual` satisfy interface `iface`? A `dynamic`/`var`/unknown actual defers
// (true); the same interface compares args; a class is checked structurally. A
// coinductive visited-pair guard makes mutually-referential interfaces terminate.
private satisfies(iface: Type, actual: Type): bool {
    if actual.is_dynamic() or actual.kind == "var" {
        return true
    }
    if actual.kind == "iface" and actual.name == iface.name {
        return .args_compatible(iface.params, actual.params)
    }
    if not .interfaces.has(iface.name) {
        return true
    }
    mut key = iface.name ++ "<:" ++ actual.name
    if .checking.get(key).unwrap_or(false) {
        return true
    }
    .checking[key] = true
    mut ok = .conforms(iface, actual)
    .checking[key] = false
    return ok
}

// Structural check: `actual` (a known class) must have every method and property
// the interface requires, with compatible signatures once both sides' type
// parameters are substituted (interface args, then the class's instantiation).
private conforms(iface: Type, actual: Type): bool {
    mut centry = .classes.get(actual.name)
    if not centry.is_some() {
        return true
    }
    mut cls = centry.unwrap()
    mut cmethods = cls.get("methods").unwrap()
    mut cfields = cls.get("fields").unwrap()
    mut def = .interfaces.get(iface.name).unwrap()

    mut ivars = .name_set(def.get("type_params").unwrap_or([]))
    mut isubst = .pair_subst(def.get("type_params").unwrap_or([]), iface.params)
    mut cvars = .class_var_set(actual.name)
    mut csubst = .receiver_subst(actual.name, actual)

    for mname, msig in def.get("methods").unwrap() {
        mut found = cmethods.get(mname)
        if not found.is_some() {
            return .reject(iface, "missing method '" ++ mname ++ "'")
        }
        mut csig = found.unwrap()
        if csig.get("is_static").unwrap_or(false) {
            return .reject(iface, "method '" ++ mname ++ "' must be an instance method")
        }
        mut iparams = msig.get("params").unwrap()
        mut cparams = csig.get("params").unwrap()
        if iparams.len() != cparams.len() {
            return .reject(iface, "method '" ++ mname ++ "' expects " ++ .count(iparams.len()) ++ " parameter(s)")
        }
        mut imvars = .merge_vars(ivars, msig.get("type_params").unwrap_or([]))
        mut cmvars = .merge_vars(cvars, csig.get("type_params").unwrap_or([]))
        mut i = 1
        for ip in iparams {
            mut it = .substitute(.resolve_with(ip, imvars), isubst)
            mut ct = .substitute(.resolve_with(cparams.get(i).unwrap(), cmvars), csubst)
            if not .compatible(it, ct) {
                return .reject(iface, "method '" ++ mname ++ "' parameter " ++ .count(i) ++ " is " ++ ct.describe() ++ ", expected " ++ it.describe())
            }
            i = i + 1
        }
        mut iret = .substitute(.resolve_with(msig.get("result").unwrap(), imvars), isubst)
        mut cret = .node_type(csig.get("result").unwrap_or(0), cmvars, csubst)
        if not .compatible(iret, cret) {
            return .reject(iface, "method '" ++ mname ++ "' returns " ++ cret.describe() ++ ", expected " ++ iret.describe())
        }
    }

    for pname, pnode in def.get("properties").unwrap() {
        mut pf = cfields.get(pname)
        if not pf.is_some() {
            return .reject(iface, "missing property '" ++ pname ++ "'")
        }
        mut it = .substitute(.resolve_with(pnode, ivars), isubst)
        mut ct = .opt_node_type(pf.unwrap(), cvars, csubst)
        if not .compatible(it, ct) {
            return .reject(iface, "property '" ++ pname ++ "' is " ++ ct.describe() ++ ", expected " ++ it.describe())
        }
    }
    return true
}

// Record why conformance failed and report not-satisfied. The reason is read back
// by `expect` to build the precise diagnostic at the use site.
private reject(iface: Type, why: str): bool {
    .iface_reason = why
    return false
}

// Resolve a type node (0 → dynamic) under a var set, then apply a substitution.
private node_type(node: dynamic, vars: Map<str, bool>, subst: Map<str, Type>): Type {
    if node == 0 {
        return Type.dynamic()
    }
    return .substitute(.resolve_with(node, vars), subst)
}

// A class field's stored type is an Option of a type node; an absent or `0` slot
// is dynamic.
private opt_node_type(opt: Option<dynamic>, vars: Map<str, bool>, subst: Map<str, Type>): Type {
    if not opt.is_some() {
        return Type.dynamic()
    }
    return .node_type(opt.unwrap(), vars, subst)
}

private name_set(names: List<str>): Map<str, bool> {
    mut out = [:]
    for n in names {
        out[n] = true
    }
    return out
}

private pair_subst(names: List<str>, types: List<Type>): Map<str, Type> {
    mut out = [:]
    mut i = 1
    for n in names {
        mut t = types.get(i)
        if t.is_some() {
            out[n] = t.unwrap()
        }
        i = i + 1
    }
    return out
}

private merge_vars(base: Map<str, bool>, names: List<str>): Map<str, bool> {
    mut out = [:]
    for k, v in base {
        out[k] = v
    }
    for n in names {
        out[n] = true
    }
    return out
}

// A call on an interface-typed receiver: look the method up in the interface's
// contract, check the args against its declared params (with the receiver's type
// args bound), and return the declared result type substituted through.
private iface_method(recv: Type, method: str, args: List<Node>, scope: Scope, call: Node): Type {
    mut def = .interfaces.get(recv.name).unwrap()
    mut msig_opt = def.get("methods").unwrap().get(method)
    if not msig_opt.is_some() {
        .fail(call, "no method '" ++ method ++ "' on interface " ++ recv.name)
    }
    mut msig = msig_opt.unwrap()
    mut vars = .merge_vars(.name_set(def.get("type_params").unwrap_or([])), msig.get("type_params").unwrap_or([]))
    mut subst = .pair_subst(def.get("type_params").unwrap_or([]), recv.params)
    .infer_and_check(msig.get("params").unwrap(), vars, args, scope, call, subst)
    mut result = msig.get("result").unwrap_or(0)
    if result == 0 {
        return Type.dynamic()
    }
    return .substitute(.resolve_with(result, vars), subst)
}

private fail(node: Node, message: str): unit {
    Error("TypeError", message, node.line(), node.col(), .source, 1).raise()
}
