// A resolved type used by the checker, erased once checking is done.

public kind: str
public name: str
public params: List<Type>
public result: Option<Type>
constructor(kind: str, name: str, params: List<Type>, result: Option<Type>) {
    .kind = kind
    .name = name
    .params = params
    .result = result
}

// `result` carries the return type only for a `fn`; every other kind is `none`, so
// the base helpers never recurse into it.
static base(kind: str): Type {
    return Type(kind, "", [], Option.none())
}

static dynamic(): Type {
    return Type.base("dynamic")
}

static unit(): Type {
    return Type.base("unit")
}

static int(): Type {
    return Type.base("int")
}

static float(): Type {
    return Type.base("float")
}

static bool(): Type {
    return Type.base("bool")
}

static str(): Type {
    return Type.base("str")
}

static class_of(name: str, args: List<Type>): Type {
    return Type("class", name, args, Option.none())
}

static enum_of(name: str, args: List<Type>): Type {
    return Type("enum", name, args, Option.none())
}

// A structural-interface type; `args` are its `<…>` arguments. A class satisfies
// it via the conformance check in Typecheck, not by nominal equality.
static iface_of(name: str, args: List<Type>): Type {
    return Type("iface", name, args, Option.none())
}

static func(params: List<Type>, result: Type): Type {
    return Type("fn", "", params, Option.some(result))
}

static var(name: str): Type {
    return Type("var", name, [], Option.none())
}

static union(members: List<Type>): Type {
    return Type("union", "", members, Option.none())
}

public is_dynamic(): bool {
    return .kind == "dynamic"
}

public is_numeric(): bool {
    return .kind == "int" or .kind == "float"
}

// Head-only nominal equality (kind, plus name for class/enum/var); generic
// arguments are compared leniently in Typecheck.compatible, not here. `int` and
// `float` are deliberately distinct.
public equals(other: Type): bool {
    if .kind != other.kind {
        return false
    }
    if .kind == "class" or .kind == "enum" or .kind == "var" or .kind == "iface" {
        return .name == other.name
    }
    return true
}

// A short label for diagnostics, rendering generic arguments as `Result<int>`.
public describe(): str {
    if .kind == "var" {
        return .name
    }
    if .kind == "union" {
        mut inner = ""
        mut i = 1
        for m in .params {
            if i > 1 {
                inner = inner ++ " | "
            }
            inner = inner ++ m.describe()
            i = i + 1
        }
        return inner
    }
    if .kind == "class" or .kind == "enum" or .kind == "iface" {
        if .params.len() == 0 {
            return .name
        }
        mut inner = ""
        mut i = 1
        for a in .params {
            if i > 1 {
                inner = inner ++ ", "
            }
            inner = inner ++ a.describe()
            i = i + 1
        }
        return .name ++ "<" ++ inner ++ ">"
    }
    if .kind == "fn" {
        mut inner = ""
        mut i = 1
        for p in .params {
            if i > 1 {
                inner = inner ++ ", "
            }
            inner = inner ++ p.describe()
            i = i + 1
        }
        return "(" ++ inner ++ ") -> " ++ .result.unwrap().describe()
    }
    return .kind
}
