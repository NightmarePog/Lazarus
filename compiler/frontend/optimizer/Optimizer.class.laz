// Optimizer — the constant-folding / propagation façade. Walks the program with a
// statement folder over a fresh constant scope, mutating the AST in place; the
// number of rewrites is exposed via `fold_count`.

import frontend.parser.Node
import frontend.optimizer.Constants
import frontend.optimizer.ExprFolder
import frontend.optimizer.StmtFolder

private folds: int = 0
private opt_level: int = 0
constructor(opt_level: int) {
    .opt_level = opt_level
}

public optimize(program: Node, class_name: str): Node {
    mut exprs = ExprFolder(.opt_level)
    exprs.register_inlineables(class_name, program.child("body"))
    mut stmts = StmtFolder(exprs, .opt_level)
    stmts.fold_block(program.child("body"), Constants.empty())
    .folds = exprs.fold_count()
    return program
}

public fold_count(): int {
    return .folds
}
