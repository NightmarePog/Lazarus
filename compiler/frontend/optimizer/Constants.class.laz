// Constants — the names currently known to hold a compile-time literal, mapping
// each to its LiteralExpr node, for constant propagation. A child scope inherits
// the current constants but drops any name shadowed by a parameter or loop
// variable (built by copying, since Laze maps cannot delete a key).

import frontend.parser.Node

constructor(.entries: Map<str, Node>)

static empty(): Constants {
    return Constants([:])
}

public record(name: str, literal: Node): unit {
    .entries[name] = literal
}

// The literal bound to `name`, or a None when it is not a known constant.
public lookup(name: str): Option<Node> {
    return .entries.get(name)
}

// A child carrying every current constant except the `shadowed` names.
public child(shadowed: List<str>): Constants {
    mut blocked = [:]
    for name in shadowed {
        blocked[name] = true
    }
    mut copy = [:]
    for key, literal in .entries {
        if not blocked.has(key) {
            copy[key] = literal
        }
    }
    return Constants(copy)
}
