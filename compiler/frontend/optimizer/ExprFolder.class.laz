// ExprFolder — constant folding and propagation for expressions. `fold` returns
// the possibly-replaced node (folding may collapse a subtree to a literal). Two
// rewrites: a name known to be a compile-time constant becomes its literal, and a
// `+`/`-`/`*`/`/` over two numeric literals is evaluated now (division by a literal
// zero is left for the runtime). Everything else just recurses.

import frontend.parser.Ast
import frontend.parser.Node
import frontend.optimizer.Constants
import std.Num

private folds: int = 0
private opt_level: int = 0
constructor(opt_level: int) {
    .opt_level = opt_level
}

public fold_count(): int {
    return .folds
}

// Pre-pass: register static single-return functions as inlining candidates (O2+).
// Populated here; used in fold_call via try_inline_call.
private inlineable: Map<str, dynamic> = [:]

public register_inlineables(class_name: str, body: List<Node>): unit {
    if .opt_level < 2 {
        return
    }
    for stmt in body {
        if stmt.kind != "FunctionDecl" {
        } else if not stmt.attr("is_static").unwrap_or(false) {
        } else if stmt.attr("raw_body").is_some() {
        } else {
            mut params = stmt.child("params")
            if params.len() <= 3 {
                mut fn_body = stmt.child("body")
                if fn_body.len() == 1 {
                    mut only = fn_body.get(1).unwrap()
                    if only.kind == "ReturnStmt" {
                        mut val = only.attr("value")
                        if val.is_some() {
                            mut key = class_name ++ "." ++ stmt.child("name")
                            .inlineable[key] = ["params": params, "expr": val.unwrap()]
                        }
                    }
                }
            }
        }
    }
}

public fold(node: Node, constants: Constants): Node {
    match node.kind {
        "IdentifierExpr" => { return .fold_identifier(node, constants) }
        "BinaryExpr" => { return .fold_binary(node, constants) }
        "CallExpr" => { return .fold_call(node, constants) }
        "ListExpr" => { return .fold_list(node, constants) }
        "MapExpr" => { return .fold_map(node, constants) }
        "UnaryExpr" => {
            node.set("operand", .fold(node.child("operand"), constants))
            return node
        }
        "MemberExpr" => {
            node.set("object", .fold(node.child("object"), constants))
            return node
        }
        "IndexExpr" => {
            node.set("object", .fold(node.child("object"), constants))
            node.set("index", .fold(node.child("index"), constants))
            return node
        }
        "ListComp" => {
            node.set("iter", .fold(node.child("iter"), constants))
            mut inner = constants.child(node.child("vars"))
            node.set("element", .fold(node.child("element"), inner))
            .fold_comp_cond(node, inner)
            return node
        }
        "MapComp" => {
            node.set("iter", .fold(node.child("iter"), constants))
            mut inner = constants.child(node.child("vars"))
            node.set("key", .fold(node.child("key"), inner))
            node.set("value", .fold(node.child("value"), inner))
            .fold_comp_cond(node, inner)
            return node
        }
        _ => {}
    }
    return node
}

// Fold a comprehension's optional filter in the loop-variable-shadowed scope.
private fold_comp_cond(node: Node, constants: Constants): unit {
    mut cond = node.attr("cond")
    if cond.is_some() {
        node.set("cond", .fold(cond.unwrap(), constants))
    }
}

private fold_identifier(node: Node, constants: Constants): Node {
    mut hit = constants.lookup(node.child("name"))
    if hit.is_some() {
        .folds = .folds + 1
        return hit.unwrap()
    }
    return node
}

private fold_binary(node: Node, constants: Constants): Node {
    mut left = .fold(node.child("left"), constants)
    mut right = .fold(node.child("right"), constants)
    mut op = node.child("op")
    if .foldable(op, left, right) {
        mut lv = Num.to_number(left.child("value")).unwrap_or(0.0)
        mut rv = Num.to_number(right.child("value")).unwrap_or(0.0)
        if op != "DIVIDE" or rv != 0.0 {
            mut result = .apply(op, lv, rv)
            .folds = .folds + 1
            return Ast.literal(.result_kind(op, left, right), Num.to_text(result).unwrap_or("0"), node.line(), node.col())
        }
    }
    node.set("left", left)
    node.set("right", right)
    return node
}

private foldable(op: str, left: Node, right: Node): bool {
    return .can_fold(op) and .is_number(left) and .is_number(right)
}

private can_fold(op: str): bool {
    return op == "PLUS" or op == "MINUS" or op == "MULTIPLY" or op == "DIVIDE"
}

private is_number(node: Node): bool {
    if node.kind != "LiteralExpr" {
        return false
    }
    mut lk = node.child("lit_kind")
    return lk == "number" or lk == "float"
}

// Division always yields a `float`; otherwise the result is a `float` only if
// either operand is one (int op int stays int).
private result_kind(op: str, left: Node, right: Node): str {
    if op == "DIVIDE" {
        return "float"
    }
    if left.child("lit_kind") == "float" or right.child("lit_kind") == "float" {
        return "float"
    }
    return "number"
}

private apply(op: str, a: dynamic, b: dynamic): dynamic {
    match op {
        "PLUS" => { return a + b }
        "MINUS" => { return a - b }
        "MULTIPLY" => { return a * b }
        _ => {}
    }
    return a / b
}

// O2 inlining candidates: zero-arg method calls that become Lua comparisons.
// Option.None is the string "None" at runtime, so is_some/is_none compare against "None".
// Values: "none_neq" | "none_eq" | "kind_ok" | "kind_err"
private static inline_builtins = [
    "is_some": "none_neq",
    "is_none": "none_eq",
    "is_ok": "kind_ok",
    "is_err": "kind_err"
]

private fold_call(node: Node, constants: Constants): Node {
    node.set("callee", .fold(node.child("callee"), constants))
    node.set("args", [.fold(arg, constants) for arg in node.child("args")])
    if .opt_level >= 2 {
        mut inlined = .try_inline_builtin(node)
        if inlined.is_some() {
            .folds = .folds + 1
            return inlined.unwrap()
        }
        mut inlined2 = .try_inline_call(node)
        if inlined2.is_some() {
            return inlined2.unwrap()
        }
    }
    return node
}

private try_inline_builtin(node: Node): Option<Node> {
    if node.child("args").len() != 0 {
        return Option.none()
    }
    mut callee = node.child("callee")
    if callee.kind != "MemberExpr" {
        return Option.none()
    }
    mut field = callee.child("field")
    mut repl = ExprFolder.inline_builtins.get(field)
    if repl.is_none() {
        return Option.none()
    }
    mut obj = callee.child("object")
    mut ln = node.line()
    mut col = node.col()
    mut kind = repl.unwrap()
    if kind == "none_neq" {
        return Option.some(Ast.binary("NEQ", obj, Ast.literal("string", "None", ln, col), ln, col))
    }
    if kind == "none_eq" {
        return Option.some(Ast.binary("EQ", obj, Ast.literal("string", "None", ln, col), ln, col))
    }
    mut kind_member = Ast.member(obj, "kind", ln, col)
    if kind == "kind_ok" {
        return Option.some(Ast.binary("EQ", kind_member, Ast.literal("string", "ok", ln, col), ln, col))
    }
    return Option.some(Ast.binary("EQ", kind_member, Ast.literal("string", "err", ln, col), ln, col))
}

private try_inline_call(node: Node): Option<Node> {
    mut callee = node.child("callee")
    if callee.kind != "MemberExpr" {
        return Option.none()
    }
    mut obj = callee.child("object")
    if obj.kind != "IdentifierExpr" {
        return Option.none()
    }
    mut key = obj.child("name") ++ "." ++ callee.child("field")
    mut entry = .inlineable.get(key)
    if entry.is_none() {
        return Option.none()
    }
    mut info = entry.unwrap()
    mut params = info["params"]
    mut args = node.child("args")
    if params.len() != args.len() {
        return Option.none()
    }
    mut mapping = [:]
    mut i = 1
    for param in params {
        mapping[param] = args.get(i).unwrap()
        i = i + 1
    }
    .folds = .folds + 1
    return Option.some(.subst(info["expr"], mapping))
}

private subst(expr: Node, mapping: Map<str, Node>): Node {
    if expr.kind == "IdentifierExpr" {
        mut hit = mapping.get(expr.child("name"))
        if hit.is_some() {
            return hit.unwrap()
        }
        return expr
    }
    if expr.kind == "LiteralExpr" {
        return expr
    }
    if expr.kind == "BinaryExpr" {
        return Ast.binary(expr.child("op"), .subst(expr.child("left"), mapping), .subst(expr.child("right"), mapping), expr.line(), expr.col())
    }
    if expr.kind == "UnaryExpr" {
        return Ast.unary(expr.child("op"), .subst(expr.child("operand"), mapping), expr.line(), expr.col())
    }
    if expr.kind == "MemberExpr" {
        return Ast.member(.subst(expr.child("object"), mapping), expr.child("field"), expr.line(), expr.col())
    }
    if expr.kind == "CallExpr" {
        mut new_args = [.subst(a, mapping) for a in expr.child("args")]
        return Ast.call(.subst(expr.child("callee"), mapping), new_args, expr.line(), expr.col())
    }
    return expr
}

private fold_list(node: Node, constants: Constants): Node {
    node.set("elements", [.fold(element, constants) for element in node.child("elements")])
    return node
}

private fold_map(node: Node, constants: Constants): Node {
    for entry in node.child("entries") {
        entry.set("key", .fold(entry.child("key"), constants))
        entry.set("value", .fold(entry.child("value"), constants))
    }
    return node
}
