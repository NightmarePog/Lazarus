// Booleanity — best-effort "is this expression provably **not** a boolean?". The
// language has no truthiness, so a condition must be an actual boolean. The check
// is conservative: it fires only on a value that cannot be a boolean and returns
// a short reason string, or "" when the expression is allowed.

#object
private arithmetic = [
    "PLUS": true,
    "MINUS": true,
    "MULTIPLY": true,
    "DIVIDE": true,
    "MODULO": true,
    "POWER": true
]

private non_bool_builtin = [
    "len": "a number (the result of '.len()')",
    "get": "an Option (the result of '.get()')",
    "pop": "an Option (the result of '.pop()')"
]

non_bool_reason(node: Node): str {
    match node.kind {
        "LiteralExpr" => { return Booleanity.literal_reason(node.child("lit_kind")) }
        "ListExpr" => { return "a list" }
        "MapExpr" => { return "a map" }
        "BinaryExpr" => { return Booleanity.binary_reason(node.child("op")) }
        "CallExpr" => {
            mut callee = node.child("callee")
            if callee.kind == "MemberExpr" {
                return Booleanity.non_bool_builtin.get(callee.child("field")).unwrap_or("")
            }
        }
        _ => {}
    }
    return ""
}

private literal_reason(lit_kind: str): str {
    if lit_kind == "number" or lit_kind == "float" {
        return "a number"
    }
    if lit_kind == "string" {
        return "a string"
    }
    return ""
}

private binary_reason(op: str): str {
    if Booleanity.arithmetic.has(op) {
        return "an arithmetic value"
    }
    if op == "CONCAT" {
        return "a string"
    }
    return ""
}
