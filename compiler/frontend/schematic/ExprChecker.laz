// ExprChecker — semantic validation of expressions against the visible scope. The
// non-structural rules: a bare identifier must be declared (or a known enum
// variant), and a bare-name call must not target a value provably not a function.
// The instance context (`in_instance` + the class's properties/methods) lets a
// `.field` / `self` access be checked; the statement checker toggles it.

@auto
import std.Str
import Error
import frontend.parser.Node
import frontend.schematic.Symbol
import frontend.schematic.Scope
import frontend.schematic.Booleanity

private source
private properties
private methods
private variant_owner
private in_instance = false

public set_instance(flag: bool) {
    .in_instance = flag
}

public instance_flag(): bool {
    return .in_instance
}

public check(node, scope) {
    match node.kind {
        "IdentifierExpr" => { .check_identifier(node, scope) }
        "BinaryExpr" => {
            .check(node.child("left"), scope)
            .check(node.child("right"), scope)
        }
        "UnaryExpr" => { .check(node.child("operand"), scope) }
        "CallExpr" => { .check_call(node, scope) }
        "MemberExpr" => { .check_member(node, scope) }
        "SelfExpr" => { .check_self(node) }
        "ListExpr" => { .check_list(node, scope) }
        "MapExpr" => { .check_map(node, scope) }
        "IndexExpr" => {
            .check(node.child("object"), scope)
            .check(node.child("index"), scope)
        }
        "ListComp" => { .check_comprehension(node, scope, ["element"]) }
        "MapComp" => { .check_comprehension(node, scope, ["key", "value"]) }
        _ => {}
    }
}

// A comprehension validates its iterable in the outer scope, then its produced
// expression(s) and optional condition in a child scope where the loop variables
// are declared (so they resolve rather than reading as undeclared).
private check_comprehension(node: Node, scope: Scope, value_keys: List<str>) {
    .check(node.child("iter"), scope)
    mut inner = scope.child()
    for name in node.child("vars") {
        inner.declare(name, Symbol("variable", false, false))
    }
    for key in value_keys {
        .check(node.child(key), inner)
    }
    mut cond = node.attr("cond")
    if cond.is_some() {
        .check_condition(cond.unwrap(), inner)
    }
}

// A condition must not be provably non-boolean (the language has no truthiness).
public check_condition(node, scope) {
    .check(node, scope)
    mut reason = Booleanity.non_bool_reason(node)
    if reason != "" {
        .fail(node, "Condition must be a boolean, but this is " ++ reason ++ "; the language has no truthiness, so use an explicit comparison or a boolean method (e.g. '.is_some()')", 1)
    }
}

private check_identifier(node, scope) {
    mut name = node.child("name")
    if scope.lookup(name).is_none() and not .variant_owner.has(name) {
        .fail(node, "Undeclared identifier '" ++ name ++ "'", Str.len(name).unwrap_or(1))
    }
}

private check_call(node, scope) {
    mut callee = node.child("callee")
    .check(callee, scope)
    if callee.kind == "IdentifierExpr" {
        mut name = callee.child("name")
        mut entry = scope.lookup(name)
        if entry.is_some() and entry.unwrap().noncallable {
            .fail(callee, "'" ++ name ++ "' is not callable; it holds a value, not a function", Str.len(name).unwrap_or(1))
        }
    }
    for arg in node.child("args") {
        .check(arg, scope)
    }
}

// A leading-dot `.field` parses to a member over `self`: valid only where a
// receiver exists, and must name a declared instance property or method. Any other
// object's field is a dynamic key, so only the object is validated.
private check_member(node, scope) {
    mut object = node.child("object")
    if object.kind == "SelfExpr" {
        mut field = node.child("field")
        if not .in_instance {
            .fail(node, "'." ++ field ++ "' refers to an instance field, but there is no receiver here; it is valid only inside an instance method or constructor", Str.len(field).unwrap_or(1) + 1)
        }
        mut known = .properties.has(field) or .methods.has(field)
        if not known {
            .fail(node, "Unknown instance member '." ++ field ++ "'; declare it as a 'private'/'public' property or an instance method", Str.len(field).unwrap_or(1) + 1)
        }
    } else {
        .check(object, scope)
    }
}

private check_self(node) {
    if not .in_instance {
        .fail(node, "'self' has no receiver here; it is valid only inside an instance method or constructor", 4)
    }
}

private check_list(node, scope) {
    for element in node.child("elements") {
        .check(element, scope)
    }
}

private check_map(node, scope) {
    for entry in node.child("entries") {
        .check(entry.child("key"), scope)
        .check(entry.child("value"), scope)
    }
}

private fail(node, message: str, span: int) {
    Error("SemanticError", message, node.line(), node.col(), .source, span).raise()
}
