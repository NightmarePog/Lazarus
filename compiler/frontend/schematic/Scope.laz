// Scope — a lexical symbol table linked to its parent. A lookup walks the parent
// chain outward; a declaration stays in the scope it is made. The root carries an
// `is_root` flag and a placeholder parent, so a miss there returns None without
// dereferencing it (the Null Object idea applied to the chain's end).

private names = [:]
private parent
private is_root: bool
@auto
constructor(parent, is_root)

static root(): Scope {
    return Scope(0, true)
}

public child(): Scope {
    return Scope(self, false)
}

public declare(name: str, symbol) {
    .names[name] = symbol
}

// Whether `name` is declared in *this* scope (not a parent) — the duplicate guard.
public declared_here(name: str): bool {
    return .names.has(name)
}

// The symbol bound to `name`, searching outward, or a None when unbound.
public lookup(name: str) {
    mut here = .names.get(name)
    if here.is_some() {
        return here
    }
    if .is_root {
        return here
    }
    return .parent.lookup(name)
}
