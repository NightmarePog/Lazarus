// Callability — whether a value is provably **not** a function, so a later `f()`
// on it can be rejected. Literals, operator/`not` results and collection literals
// are never functions; anything else (a call, a name, a field) is possibly one.

#object
private non_function = [
    "LiteralExpr": true,
    "BinaryExpr": true,
    "UnaryExpr": true,
    "ListExpr": true,
    "MapExpr": true
]

is_noncallable(node: Node): bool {
    return Callability.non_function.has(node.kind)
}
