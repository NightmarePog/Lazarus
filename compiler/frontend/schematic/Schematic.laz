// Schematic — the semantic-analysis façade. Collects the class's instance
// properties and methods up front (so a `.field` access resolves regardless of
// order), binds the class name and imports into a root scope (so construction and
// `Other.static()` resolve), then walks the top-level block. First violation raises.

#object
import std.Str
import Error
import frontend.schematic.Symbol
import frontend.schematic.Scope
import frontend.schematic.Frame
import frontend.schematic.ExprChecker
import frontend.schematic.StmtChecker

// `enums` maps an enum name to its variant names and `variant_owner` each variant
// back to its enum — gathered across all modules, so an imported enum is still
// known here. They drive `match` exhaustiveness checking.
analyze(program: Node, source: str, class_name: str, imports: List<str>, variant_owner: Map<str, str>, enums: Map<str, List<str>>, variant_arity: Map<str, int>, gated_externs: Map<str, str>): unit {
    mut properties = [:]
    mut methods = [:]
    Schematic.collect_members(program, properties, methods, source)

    mut root = Scope.root()
    root.declare(class_name, Symbol("class", false, false))
    for name in imports {
        root.declare(name, Symbol("class", false, false))
    }
    // Built-in collection / optional namespaces, available without an import:
    // `Option.some/none`, `Result.ok/err`, and the List/Map literal types.
    for name in ["Option", "Result", "List", "Map"] {
        root.declare(name, Symbol("class", false, false))
    }

    // Declare platform-available extern names in root scope so bare calls within
    // the same class resolve. Gated externs are excluded — ExprChecker emits the
    // "compile with --platform X" error when they are referenced.
    for stmt in program.child("body") {
        if stmt.kind == "ExternDecl" {
            mut ename = stmt.child("name")
            if not gated_externs.has(ename) {
                root.declare(ename, Symbol("function", false, false))
            }
        }
    }

    mut exprs = ExprChecker(source, properties, methods, variant_owner, gated_externs)
    mut stmts = StmtChecker(source, exprs, variant_owner, enums, variant_arity)
    exprs.inject_stmts(stmts)
    stmts.check_block(program.child("body"), root, Frame(false, false, false))
}

// Gather instance properties (top-level visible non-static bindings) and instance
// methods (non-static functions), rejecting duplicate properties.
private collect_members(program: Node, properties: Map<str, bool>, methods: Map<str, bool>, source: str): unit {
    for stmt in program.child("body") {
        mut k = stmt.kind
        if k == "VariableDecl" {
            Schematic.collect_property(stmt, properties, source)
        } else if k == "FunctionDecl" {
            if not stmt.attr("is_static").unwrap_or(false) {
                methods[stmt.child("name")] = true
            }
        }
    }
}

private collect_property(stmt: Node, properties: Map<str, bool>, source: str): unit {
    mut visibility = stmt.attr("visibility").unwrap_or("")
    mut is_static = stmt.attr("is_static").unwrap_or(false)
    if visibility != "" and not is_static {
        mut name = stmt.child("name")
        if properties.has(name) {
            Error("SemanticError", "Duplicate declaration '" ++ name ++ "'", stmt.line(), stmt.col(), source, Str.len(name).unwrap_or(1)).raise()
        }
        properties[name] = true
    }
}
