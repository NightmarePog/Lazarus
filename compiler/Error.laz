// A located compiler error rendered as a coloured diagnostic box: a type label, a
// `unknown:line:col` location, the message, and a source snippet with a caret
// under the offending column. No exceptions, so `raise()` prints and exits.

import std.Str
import std.Sys

public kind
public message
public line
public column
public source
public span

constructor(kind: str, message: str, line: int, column: int, source: str, span: int) {
    .kind = kind
    .message = message
    .line = line
    .column = column
    .source = source
    .span = span
}

public to_string(): str {
    return .format()
}

public raise() {
    Sys.print(.format())
    Sys.exit(1)
}

public format(): str {
    mut esc = Str.char(27).unwrap_or("")
    mut red = esc ++ "[31m"
    mut bold = esc ++ "[1m"
    mut reset = esc ++ "[0m"
    mut nl = Str.char(10).unwrap_or("")

    mut prefix = Str.format("   %d │ ", .line).unwrap_or("")
    mut pad = Str.rep(" ", Error.display_width(prefix) + .column - 1).unwrap_or("")
    mut carets = red ++ Str.rep("^", .span).unwrap_or("^") ++ reset

    mut out = ""
    out = out ++ nl
    out = out ++ red ++ "╭─ Error ──────────────────────────────" ++ reset ++ nl
    out = out ++ "│ Type: " ++ bold ++ .kind ++ reset ++ nl
    out = out ++ Str.format("│ Location: unknown:%d:%d", .line, .column).unwrap_or("│ Location: unknown") ++ nl
    out = out ++ "│" ++ nl
    out = out ++ "│ " ++ .message ++ nl
    out = out ++ "│" ++ nl
    out = out ++ "│ " ++ prefix ++ Error.source_line(.source, .line) ++ nl
    out = out ++ "│ " ++ pad ++ carets ++ nl
    out = out ++ red ++ "╰──────────────────────────────────────" ++ reset
    return out
}

// The 1-based `target` line of `source`, without its trailing newline.
static source_line(source: str, target: int): str {
    mut nl = Str.char(10).unwrap_or("")
    mut len = Str.len(source).unwrap_or(0)
    mut cur = 1
    mut out = ""
    mut i = 1
    loop {
        if i > len {
            break
        }
        mut c = Str.sub(source, i, i).unwrap_or("")
        if c == nl {
            if cur == target {
                break
            }
            cur = cur + 1
            out = ""
        } else {
            if cur == target {
                out = out ++ c
            }
        }
        i = i + 1
    }
    return out
}

// Display width in codepoints: UTF-8 continuation bytes (0x80..0xBF) don't count,
// so the multibyte `│` in the prefix aligns the caret correctly.
static display_width(s: str): int {
    mut len = Str.len(s).unwrap_or(0)
    mut w = 0
    mut i = 1
    loop {
        if i > len {
            break
        }
        mut b = Str.byte(s, i).unwrap_or(0)
        if b < 128 {
            w = w + 1
        } else {
            if b >= 192 {
                w = w + 1
            }
        }
        i = i + 1
    }
    return w
}
