// Text — string assembly helpers for the code generator: newline-joining and
// block indentation. The lexer does not process escapes, so a literal newline
// comes from `Str.char(10)`, not a `\n`.

@object
import std.Str

nl(): str {
    return Str.char(10).unwrap_or("")
}

join(parts, sep: str): str {
    mut out = ""
    mut first = true
    for part in parts {
        if first {
            out = part
            first = false
        } else {
            out = out ++ sep ++ part
        }
    }
    return out
}

lines(parts): str {
    return Text.join(parts, Text.nl())
}

// Indent every non-empty line of `text` by four spaces; blank lines stay empty so
// the output carries no trailing whitespace.
indent(text: str): str {
    mut newline = Text.nl()
    mut n = Str.len(text).unwrap_or(0)
    mut out = ""
    mut line = ""
    mut i = 1
    loop {
        if i > n {
            break
        }
        mut ch = Str.sub(text, i, i).unwrap_or("")
        if ch == newline {
            out = out ++ Text.prefix(line) ++ newline
            line = ""
        } else {
            line = line ++ ch
        }
        i = i + 1
    }
    return out ++ Text.prefix(line)
}

private prefix(line: str): str {
    if line == "" {
        return ""
    }
    return "    " ++ line
}
