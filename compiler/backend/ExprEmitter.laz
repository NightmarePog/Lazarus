// ExprEmitter — lowers an expression AST node to a Lua source string. The
// interesting work is call dispatch, checked in order: an extern call -> its raw
// Lua target wrapped at the Option boundary; a built-in collection method -> its
// `__lz_*` helper; a class name in call position -> `C.new(...)`; a `self` method
// -> `C.m(self, ...)`; any other instance call -> Lua colon `obj:m(...)`;
// everything else -> a plain call.

@auto
import std.Str
import backend.Text
import frontend.parser.Node

private static op_map = [
    "PLUS": "+",
    "MINUS": "-",
    "MULTIPLY": "*",
    "DIVIDE": "/",
    "POWER": "^",
    "CONCAT": "..",
    "EQ": "==",
    "NEQ": "~=",
    "LESS": "<",
    "LESS_EQUAL": "<=",
    "GREATER": ">",
    "GREATER_EQUAL": ">=",
    "AND": "and",
    "OR": "or"
]

// Built-in collection / Option / Result methods, lowering to a `__lz_*` helper
// with the receiver as the first argument. `unwrap`/`unwrap_or` serve both Option
// and Result (the helper dispatches on the runtime tag).
private static builtins = [
    "len": "__lz_len",
    "push": "__lz_push",
    "pop": "__lz_pop",
    "get": "__lz_get",
    "has": "__lz_has",
    "is_some": "__lz_is_some",
    "is_none": "__lz_is_none",
    "is_ok": "__lz_is_ok",
    "is_err": "__lz_is_err",
    "unwrap": "__lz_unwrap",
    "unwrap_or": "__lz_unwrap_or",
    "error": "__lz_error"
]

// Built-in constructors `Option.some/none` and `Result.ok/err`, keyed by
// `Type.method`, lowering directly to their `__lz_*` primitive.
private static constructors = [
    "Option.some": "__lz_some",
    "Option.none": "__lz_none",
    "Result.ok": "__lz_ok",
    "Result.err": "__lz_err"
]

private ctx

public emit(node): str {
    match node.kind {
        "LiteralExpr" => { return .emit_literal(node) }
        "IdentifierExpr" => { return .emit_identifier(node) }
        "SelfExpr" => { return "self" }
        "MemberExpr" => { return .emit_field(node) }
        "ListExpr" => { return .emit_list(node) }
        "MapExpr" => { return .emit_map(node) }
        "IndexExpr" => { return .emit_index(node) }
        "CallExpr" => { return .emit_call(node) }
        "UnaryExpr" => { return .emit_unary(node) }
        "BinaryExpr" => { return .emit_binary(node) }
        "ListComp" => { return .emit_list_comp(node) }
        "MapComp" => { return .emit_map_comp(node) }
        _ => {}
    }
    return ""
}

// A list comprehension lowers to an immediately-invoked function that builds a
// fresh list: iterate the source with the same `__lz_each` form as a for-in,
// optionally guard with the filter, and push each element. The closure captures
// `self`, so `[.f(x) for x in xs]` works.
private emit_list_comp(node: Node): str {
    .ctx.mark_collections()
    mut iter = .emit(node.child("iter"))
    mut temp = .ctx.fresh_temp()
    .ctx.push_scope()
    .declare_loop_vars(node.child("vars"))
    mut header = .each_header(node.child("vars"), iter)
    mut body = .comp_body(node, "__lz_push(" ++ temp ++ ", " ++ .emit(node.child("element")) ++ ")")
    .ctx.pop_scope()
    return "(function() local " ++ temp ++ " = __lz_list() " ++ header ++ " " ++ body ++ " end return " ++ temp ++ " end)()"
}

private emit_map_comp(node: Node): str {
    .ctx.mark_collections()
    mut iter = .emit(node.child("iter"))
    mut temp = .ctx.fresh_temp()
    .ctx.push_scope()
    .declare_loop_vars(node.child("vars"))
    mut header = .each_header(node.child("vars"), iter)
    mut body = .comp_body(node, "__lz_idx_set(" ++ temp ++ ", " ++ .emit(node.child("key")) ++ ", " ++ .emit(node.child("value")) ++ ")")
    .ctx.pop_scope()
    return "(function() local " ++ temp ++ " = __lz_map({}) " ++ header ++ " " ++ body ++ " end return " ++ temp ++ " end)()"
}

private declare_loop_vars(vars: List<str>) {
    for name in vars {
        .ctx.declare_local(name)
    }
}

// The loop body: the add expression, wrapped in `if <cond> then … end` for a
// filtered comprehension.
private comp_body(node: Node, add: str): str {
    mut cond = node.attr("cond")
    if cond.is_some() {
        return "if " ++ .emit(cond.unwrap()) ++ " then " ++ add ++ " end"
    }
    return add
}

// The `for … in __lz_each(iter) do` header, matching the for-in lowering: a single
// variable takes the value (index discarded); two take key and value.
private each_header(vars: List<str>, iter: str): str {
    if vars.len() == 1 {
        return "for _, " ++ vars.get(1).unwrap() ++ " in __lz_each(" ++ iter ++ ") do"
    }
    return "for " ++ Text.join(vars, ", ") ++ " in __lz_each(" ++ iter ++ ") do"
}

// A bare name: a nullary enum variant lowers to its owner-qualified form, anything
// else to the context's resolved name (local, member, or extern).
private emit_identifier(node): str {
    mut id = node.child("name")
    if .ctx.is_variant(id) {
        return .ctx.variant_qualified(id)
    }
    return .ctx.emit_name(id)
}

private emit_literal(node): str {
    mut lit_kind = node.child("lit_kind")
    mut value = node.child("value")
    if lit_kind == "string" {
        return Str.format("%q", value).unwrap_or("''")
    }
    if lit_kind == "boolean" {
        if value {
            return "true"
        }
        return "false"
    }
    return value
}

private emit_field(node): str {
    return .emit_operand(node.child("object")) ++ "." ++ node.child("field")
}

private emit_list(node): str {
    .ctx.mark_collections()
    return "__lz_list(" ++ Text.join(.emit_args(node.child("elements")), ", ") ++ ")"
}

private emit_map(node): str {
    .ctx.mark_collections()
    mut parts = []
    for entry in node.child("entries") {
        parts.push("[" ++ .emit(entry.child("key")) ++ "] = " ++ .emit(entry.child("value")))
    }
    return "__lz_map({" ++ Text.join(parts, ", ") ++ "})"
}

private emit_index(node): str {
    .ctx.mark_collections()
    return "__lz_idx_get(" ++ .emit(node.child("object")) ++ ", " ++ .emit(node.child("index")) ++ ")"
}

private emit_unary(node): str {
    return "not " ++ .emit_operand(node.child("operand"))
}

private emit_binary(node): str {
    mut left = .emit_operand(node.child("left"))
    mut right = .emit_operand(node.child("right"))
    mut op = node.child("op")
    if op == "MODULO" {
        return "(" ++ left ++ " - math.floor(" ++ left ++ " / " ++ right ++ ") * " ++ right ++ ")"
    }
    return left ++ " " ++ ExprEmitter.op_map.get(op).unwrap_or(op) ++ " " ++ right
}

private emit_call(node): str {
    mut callee = node.child("callee")
    mut args = .emit_args(node.child("args"))

    if callee.kind == "MemberExpr" {
        mut object = callee.child("object")
        mut field = callee.child("field")

        if object.kind == "IdentifierExpr" {
            mut target = .ctx.extern_target(object.child("name"), field)
            if target.is_some() {
                .ctx.mark_collections()
                return "__lz_wrap(" ++ target.unwrap() ++ "(" ++ Text.join(args, ", ") ++ "))"
            }
            mut ctor = ExprEmitter.constructors.get(object.child("name") ++ "." ++ field)
            if ctor.is_some() {
                .ctx.mark_collections()
                return ctor.unwrap() ++ "(" ++ Text.join(args, ", ") ++ ")"
            }
        }

        mut helper = ExprEmitter.builtins.get(field)
        if helper.is_some() {
            .ctx.mark_collections()
            return helper.unwrap() ++ "(" ++ Text.join(.with_receiver(object, args), ", ") ++ ")"
        }
    }

    if callee.kind == "IdentifierExpr" {
        mut name = callee.child("name")
        if .ctx.is_construction(name) {
            return name ++ ".new(" ++ Text.join(args, ", ") ++ ")"
        }
    }

    if callee.kind == "MemberExpr" {
        mut object = callee.child("object")
        mut field = callee.child("field")
        if object.kind == "SelfExpr" and .ctx.is_instance_method(field) {
            return .ctx.name() ++ "." ++ field ++ "(" ++ Text.join(.with_receiver(object, args), ", ") ++ ")"
        }
        if not .receiver_is_class(object) {
            return .emit_operand(object) ++ ":" ++ field ++ "(" ++ Text.join(args, ", ") ++ ")"
        }
    }

    mut callee_src = .emit(callee)
    if callee.kind == "BinaryExpr" {
        callee_src = "(" ++ callee_src ++ ")"
    }
    return callee_src ++ "(" ++ Text.join(args, ", ") ++ ")"
}

// Emit an operand, parenthesising a binary/unary expression that would otherwise
// bind wrongly as an indexed/called/operated value.
private emit_operand(node): str {
    mut src = .emit(node)
    if .needs_parens(node) {
        return "(" ++ src ++ ")"
    }
    return src
}

private needs_parens(node): bool {
    return node.kind == "BinaryExpr" or node.kind == "UnaryExpr"
}

private receiver_is_class(object): bool {
    if object.kind != "IdentifierExpr" {
        return false
    }
    return .ctx.is_construction(object.child("name"))
}

// The argument list with the receiver prepended (built-in and instance-method
// calls pass the receiver as the first argument).
private with_receiver(object, args) {
    mut out = [.emit_operand(object)]
    for arg in args {
        out.push(arg)
    }
    return out
}

private emit_args(nodes) {
    mut out = []
    for node in nodes {
        out.push(.emit(node))
    }
    return out
}
