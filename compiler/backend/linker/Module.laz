// Module — one loaded compilation unit from the Linker: its resolved file `path`,
// `class_name` (the file stem), raw `source` (for error snippets), parsed `ast`
// (a Program node with imports stripped), and `imports` (the visible class names).

public path
public class_name
public source
public ast
public imports

constructor(path: str, class_name: str, source: str, ast, imports) {
    .path = path
    .class_name = class_name
    .source = source
    .ast = ast
    .imports = imports
}
