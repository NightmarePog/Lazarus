// StmtEmitter — lowers statements and class members to Lua source text.
//
// `emit_member` lowers a top-level declaration (method -> `function C.name`, an
// instance method gaining an implicit `self`; binding -> `C.name = value`;
// constructor -> `function C.new`, which builds a table, copies instance methods
// on for colon dispatch, seeds property defaults, runs the body and returns it).
// `emit_stmt` lowers ordinary statements, declaring locals in the context so
// member references stay qualified while locals stay bare.

import std.Num
import backend.CgContext
import backend.ExprEmitter
import backend.Text
import frontend.parser.Node

private ctx: CgContext
private exprs: ExprEmitter
@auto
constructor(ctx: CgContext, exprs: ExprEmitter)

public emit_member(node: Node): str {
    mut hint = .source_hint(node)
    mut body = ""
    match node.kind {
        "FunctionDecl" => {
            if node.attr("raw_body").is_some() {
                body = .emit_lua_method(node)
            } else {
                body = .emit_method(node)
            }
        }
        "VariableDecl" => { body = .emit_static_field(node) }
        "ConstructorDecl" => { body = .emit_constructor(node) }
        "EnumDecl" => { body = .emit_enum(node) }
        _ => { return .emit_stmt(node) }
    }
    if hint == "" {
        return body
    }
    return hint ++ Text.nl() ++ body
}

// A nullary variant lowers to `E.V = 'V'`; a payload variant to a constructor
// `function E.V(_1, …) return { kind='V', … }`.
private emit_enum(node: Node): str {
    mut lines = []
    for variant in node.child("variants") {
        mut name = variant.child("name")
        mut mangled_name = .ctx.mangle_self_member(name)
        if variant.child("fields").len() == 0 {
            // String tag uses original name — it's a runtime value matched with ==
            lines.push(.ctx.name() ++ "." ++ mangled_name ++ " = '" ++ name ++ "'")
        } else {
            lines.push(.emit_variant_ctor(name, mangled_name, variant.child("fields")))
        }
    }
    return Text.lines(lines)
}

private emit_variant_ctor(name: str, mangled_name: str, fields: List<Node>): str {
    mut params = []
    // kind tag uses original name — matched by match arms as string
    mut assigns = ["kind = '" ++ name ++ "'"]
    mut i = 1
    for field in fields {
        mut s = Num.to_text(i).unwrap_or("0")
        params.push("_" ++ s)
        assigns.push("_" ++ s ++ " = _" ++ s)
        i = i + 1
    }
    mut header = "function " ++ .ctx.name() ++ "." ++ mangled_name ++ "(" ++ Text.join(params, ", ") ++ ")"
    return Text.lines([header, Text.indent("return { " ++ Text.join(assigns, ", ") ++ " }"), "end"])
}

// Statement boundary: emit the node, then prepend any pending `?`-propagation
// lines accumulated during expression emission. A source-location comment is
// prepended so runtime Lua errors can be mapped back to the Lazarus source.
public emit_stmt(node: Node): str {
    mut result = .emit_stmt_inner(node)
    mut prefix = .exprs.take_pending()
    mut hint = .source_hint(node)
    if prefix.len() == 0 {
        if hint == "" {
            return result
        }
        return hint ++ Text.nl() ++ result
    }
    prefix.push(result)
    mut body = Text.lines(prefix)
    if hint == "" {
        return body
    }
    return hint ++ Text.nl() ++ body
}

private source_hint(node: Node): str {
    if .ctx.opt_level() >= 1 {
        return ""
    }
    mut ln = node.line()
    if ln == 0 {
        return ""
    }
    return "-- " ++ .ctx.name() ++ ":" ++ Num.to_text(ln).unwrap_or("?")
}

private emit_stmt_inner(node: Node): str {
    match node.kind {
        "VariableDecl" => { return .emit_variable(node) }
        "FieldAssign" => { return .exprs.emit(node.child("target")) ++ " = " ++ .exprs.emit(node.child("value")) }
        "IndexAssign" => { return .emit_index_assign(node) }
        "ExpressionStmt" => { return .exprs.emit(node.child("expression")) }
        "FunctionDecl" => { return .emit_local_function(node) }
        "ReturnStmt" => { return .emit_return(node) }
        "IfStmt" => { return .emit_if(node) }
        "WhileStmt" => { return .emit_while(node) }
        "LoopStmt" => { return .emit_loop(node) }
        "BreakStmt" => { return "break" }
        "ForStmt" => { return .emit_for(node) }
        "ForInStmt" => { return .emit_for_in(node) }
        "MatchStmt" => { return .emit_match(node) }
        _ => {}
    }
    return ""
}

// A `match` lowers to an `if/elseif/else` ladder over a once-evaluated temp, so
// the scrutinee runs exactly once. Each value arm becomes an `== pattern` test;
// the `_` arm becomes the `else` (or a bare `do ... end` when it is the only arm).
// Binding arms (`n if cond =>` or `n =>`) hoist `local n = temp` before the chain.
private emit_match(node: Node): str {
    mut scrutinee_node = node.child("scrutinee")
    mut scrutinee_str = .exprs.emit(scrutinee_node)
    mut temp = ""
    mut parts = []
    if .ctx.opt_level() >= 2 and scrutinee_node.kind == "IdentifierExpr" and .ctx.is_local(scrutinee_node.child("name")) {
        temp = scrutinee_str
    } else {
        temp = .ctx.fresh_temp()
        parts.push("local " ++ temp ++ " = " ++ scrutinee_str)
    }
    // Hoist binding names so the guard condition and body both see them.
    .ctx.push_scope()
    for arm in node.child("arms") {
        if arm.attr("is_binding").unwrap_or(false) {
            mut bname = arm.child("pattern").child("name")
            if not .ctx.is_local(bname) {
                .ctx.declare_local(bname)
                parts.push("local " ++ bname ++ " = " ++ temp)
            }
        }
    }
    mut first = true
    mut has_default = false
    mut default_body = []
    for arm in node.child("arms") {
        if arm.attr("is_binding").unwrap_or(false) {
            mut bguard = arm.attr("guard")
            if bguard.is_some() {
                mut keyword = "elseif "
                if first {
                    keyword = "if "
                }
                first = false
                parts.push(keyword ++ .exprs.emit(bguard.unwrap()) ++ " then")
                .push_block(parts, arm.child("body"))
            } else {
                has_default = true
                default_body = arm.child("body")
            }
        } else if arm.attr("is_wildcard").unwrap_or(false) {
            mut wguard = arm.attr("guard")
            if wguard.is_some() {
                mut keyword = "elseif "
                if first {
                    keyword = "if "
                }
                first = false
                parts.push(keyword ++ .exprs.emit(wguard.unwrap()) ++ " then")
                .push_block(parts, arm.child("body"))
            } else {
                has_default = true
                default_body = arm.child("body")
            }
        } else {
            mut keyword = "elseif "
            if first {
                keyword = "if "
            }
            first = false
            parts.push(keyword ++ .match_condition(temp, arm) ++ " then")
            if .has_bindings(arm) {
                .push_payload_body(parts, temp, arm)
            } else {
                .push_block(parts, arm.child("body"))
            }
        }
    }
    if first {
        if has_default {
            parts.push("do")
            .push_block(parts, default_body)
            parts.push("end")
        }
        .ctx.pop_scope()
        return Text.lines(parts)
    }
    if has_default {
        parts.push("else")
        .push_block(parts, default_body)
    }
    parts.push("end")
    .ctx.pop_scope()
    return Text.lines(parts)
}

// A payload variant matches on the tagged table's `kind`; a nullary variant
// compares against its name string; a value arm against its pattern.
// A guard `if cond` appends `and <cond>` to the condition.
private match_condition(temp: str, arm: Node): str {
    mut base = ""
    if arm.attr("is_variant").unwrap_or(false) {
        if .has_bindings(arm) {
            base = temp ++ ".kind == '" ++ arm.child("variant") ++ "'"
        } else {
            base = temp ++ " == '" ++ arm.child("variant") ++ "'"
        }
    } else {
        base = temp ++ " == " ++ .exprs.emit(arm.child("pattern"))
    }
    mut guard = arm.attr("guard")
    if guard.is_some() {
        return base ++ " and " ++ .exprs.emit(guard.unwrap())
    }
    return base
}

private has_bindings(arm: Node): bool {
    return arm.attr("is_variant").unwrap_or(false) and arm.child("bindings").len() > 0
}

// A payload arm's body, preceded by `local <name> = <temp>._<n>` extractions for
// each bound field (`_` skips one). Scoped so bindings don't leak between arms.
private push_payload_body(parts: List<str>, temp: str, arm: Node): unit {
    .ctx.push_scope()
    mut lines = []
    mut i = 1
    for name in arm.child("bindings") {
        if name != "_" {
            .ctx.declare_local(name)
            lines.push("local " ++ name ++ " = " ++ temp ++ "._" ++ Num.to_text(i).unwrap_or("0"))
        }
        i = i + 1
    }
    for stmt in arm.child("body") {
        lines.push(.emit_stmt(stmt))
    }
    .ctx.pop_scope()
    if lines.len() > 0 {
        parts.push(Text.indent(Text.lines(lines)))
    }
}

// A statement list as an indented block, or "" when empty.
private emit_block(stmts: List<Node>): str {
    if stmts.len() == 0 {
        return ""
    }
    return Text.indent(Text.lines([.emit_stmt(stmt) for stmt in stmts]))
}

// A function body with its parameters declared as locals in a fresh scope.
// `param_types` (without self) is used to emit nil-guards for default params.
private emit_fn_body(params: List<str>, param_types: List<Node>, body: List<Node>): str {
    .ctx.push_scope()
    for param in params {
        .ctx.declare_local(param)
    }
    mut lines = .default_guards(params, param_types)
    for stmt in body {
        lines.push(.emit_stmt(stmt))
    }
    .ctx.pop_scope()
    if lines.len() == 0 {
        return ""
    }
    return Text.indent(Text.lines(lines))
}

// Emit `if p == nil then p = <default> end` for each param that has a default.
// Skips "self" and aligns index into param_types (which never includes self).
private default_guards(params: List<str>, param_types: List<Node>): List<str> {
    mut lines = []
    mut type_i = 1
    for pname in params {
        if pname != "self" {
            mut pt = param_types.get(type_i)
            if pt.is_some() {
                mut def = pt.unwrap().attr("default")
                if def.is_some() {
                    lines.push("if " ++ pname ++ " == nil then " ++ pname ++ " = " ++ .exprs.emit(def.unwrap()) ++ " end")
                }
            }
            type_i = type_i + 1
        }
    }
    return lines
}

private emit_variable(node: Node): str {
    mut name = node.child("name")
    mut value = node.attr("value")
    if node.attr("reassign").unwrap_or(false) {
        mut rhs = "nil"
        if value.is_some() {
            rhs = .exprs.emit(value.unwrap())
        }
        return .ctx.emit_name(name) ++ " = " ++ rhs
    }
    .ctx.declare_local(name)
    mut mangled = .ctx.mangle_local(name)
    if value.is_some() {
        return "local " ++ mangled ++ " = " ++ .exprs.emit(value.unwrap())
    }
    return "local " ++ mangled
}

private emit_index_assign(node: Node): str {
    mut target = node.child("target")
    mut idx_set = .ctx.mangle_class("List") ++ "." ++ .ctx.mangle_member("List", "__lz_idx_set")
    return idx_set ++ "(" ++ .exprs.emit(target.child("object")) ++ ", " ++ .exprs.emit(target.child("index")) ++ ", " ++ .exprs.emit(node.child("value")) ++ ")"
}

private emit_local_function(node: Node): str {
    mut orig_name = node.child("name")
    .ctx.declare_local(orig_name)
    mut mangled = .ctx.mangle_local(orig_name)
    mut header = "local function " ++ mangled ++ "(" ++ Text.join(.mangle_params(node.child("params")), ", ") ++ ")"
    return .wrap_body(header, .emit_fn_body(node.child("params"), node.child("param_types"), node.child("body")))
}

private emit_return(node: Node): str {
    mut value = node.attr("value")
    if value.is_some() {
        return "return " ++ .exprs.emit(value.unwrap())
    }
    return "return"
}

private emit_if(node: Node): str {
    // O1: dead-branch markers set by StmtFolder.elim_dead_branches
    mut dead_true = node.attr("dead_true")
    if dead_true.is_some() {
        mut lines = [.emit_stmt(s) for s in dead_true.unwrap()]
        return Text.lines(lines)
    }
    if node.attr("dead_empty").unwrap_or(false) {
        return ""
    }

    mut parts = []
    for i, clause in node.child("clauses") {
        mut keyword = "elseif "
        if i == 0 {
            keyword = "if "
        }
        parts.push(keyword ++ .exprs.emit(clause.child("condition")) ++ " then")
        .push_block(parts, clause.child("body"))
    }
    mut else_body = node.attr("else_body")
    if else_body.is_some() {
        parts.push("else")
        .push_block(parts, else_body.unwrap())
    }
    parts.push("end")
    return Text.lines(parts)
}

private emit_while(node: Node): str {
    mut parts = ["while " ++ .exprs.emit(node.child("condition")) ++ " do"]
    .push_block(parts, node.child("body"))
    parts.push("end")
    return Text.lines(parts)
}

private emit_loop(node: Node): str {
    mut parts = ["while true do"]
    .push_block(parts, node.child("body"))
    parts.push("end")
    return Text.lines(parts)
}

// The C-style `for` lowers to a `while` wrapped in `do ... end` so the loop
// variable stays scoped; the step runs at the end of each iteration.
private emit_for(node: Node): str {
    mut loop_body = []
    for stmt in node.child("body") {
        loop_body.push(stmt)
    }
    mut step = node.attr("step")
    if step.is_some() {
        loop_body.push(step.unwrap())
    }

    mut do_body = []
    mut init = node.attr("init")
    if init.is_some() {
        do_body.push(.emit_stmt(init.unwrap()))
    }

    mut cond = "true"
    mut condition = node.attr("condition")
    if condition.is_some() {
        cond = .exprs.emit(condition.unwrap())
    }
    mut while_parts = ["while " ++ cond ++ " do"]
    .push_block(while_parts, loop_body)
    while_parts.push("end")
    do_body.push(Text.lines(while_parts))

    return Text.lines(["do", Text.indent(Text.lines(do_body)), "end"])
}

// `for x in c` / `for k, v in c` lowers to a generic-for over `__lz_each(c)`,
// which yields (0-based index, value) for a list and (key, value) for a map; a
// single loop variable takes the value, so a throwaway `_` holds the index/key.
private emit_for_in(node: Node): str {
    mut iter = .exprs.emit(node.child("iter"))
    .ctx.push_scope()
    mut vars = node.child("vars")
    for name in vars {
        .ctx.declare_local(name)
    }
    mut vars_mangled = [.ctx.mangle_local(v) for v in vars]
    mut each = .ctx.mangle_class("List") ++ "." ++ .ctx.mangle_member("List", "__lz_each")
    mut header = ""
    if vars.len() == 1 {
        header = "for _, " ++ vars_mangled.get(1).unwrap() ++ " in " ++ each ++ "(" ++ iter ++ ") do"
    } else {
        header = "for " ++ Text.join(vars_mangled, ", ") ++ " in " ++ each ++ "(" ++ iter ++ ") do"
    }
    mut parts = [header]
    .push_block(parts, node.child("body"))
    parts.push("end")
    .ctx.pop_scope()
    return Text.lines(parts)
}

private emit_method(node: Node): str {
    mut params = node.child("params")
    mut lua_params = params
    if not node.attr("is_static").unwrap_or(false) {
        lua_params = .with_self(params)
    }
    mut header = "function " ++ .ctx.name() ++ "." ++ .ctx.mangle_self_member(node.child("name")) ++ "(" ++ Text.join(.mangle_params(lua_params), ", ") ++ ")"
    return .wrap_body(header, .emit_fn_body(lua_params, node.child("param_types"), node.child("body")))
}

private emit_lua_method(node: Node): str {
    mut params = node.child("params")
    mut lua_params = params
    if not node.attr("is_static").unwrap_or(false) {
        lua_params = .with_self(params)
    }
    // Raw body references params by original name — never mangle the param list here.
    mut header = "function " ++ .ctx.name() ++ "." ++ .ctx.mangle_self_member(node.child("name")) ++ "(" ++ Text.join(lua_params, ", ") ++ ")"
    return Text.lines([header, Text.indent(node.child("raw_body")), "end"])
}

private emit_static_field(node: Node): str {
    mut value = node.attr("value")
    mut rhs = "nil"
    if value.is_some() {
        rhs = .exprs.emit(value.unwrap())
    }
    return .ctx.name() ++ "." ++ .ctx.mangle_self_member(node.child("name")) ++ " = " ++ rhs
}

private emit_constructor(node: Node): str {
    .ctx.push_scope()
    for param in node.child("params") {
        .ctx.declare_local(param)
    }
    .ctx.declare_local("self")

    mut self_name = .ctx.mangle_local("self")
    mut lines = ["local " ++ self_name ++ " = {}"]
    for guard in .default_guards(node.child("params"), node.child("param_types")) {
        lines.push(guard)
    }
    for method in .ctx.instance_method_names() {
        mut mangled = .ctx.mangle_self_member(method)
        lines.push(self_name ++ "." ++ mangled ++ " = " ++ .ctx.name() ++ "." ++ mangled)
    }
    for prop in .ctx.property_decls() {
        mut value = prop.attr("value")
        if value.is_some() {
            lines.push(self_name ++ "." ++ .ctx.mangle_self_member(prop.child("name")) ++ " = " ++ .exprs.emit(value.unwrap()))
        }
    }
    for stmt in node.child("body") {
        lines.push(.emit_stmt(stmt))
    }
    lines.push("return " ++ self_name)
    .ctx.pop_scope()

    mut header = "function " ++ .ctx.name() ++ ".new(" ++ Text.join(.mangle_params(node.child("params")), ", ") ++ ")"
    return Text.lines([header, Text.indent(Text.lines(lines)), "end"])
}

public emit_closure(params: List<str>, param_types: List<Node>, body: List<Node>): str {
    mut header = "function(" ++ Text.join(.mangle_params(params), ", ") ++ ")"
    return .wrap_body(header, .emit_fn_body(params, param_types, body))
}

private mangle_params(params: List<str>): List<str> {
    return [.ctx.mangle_local(p) for p in params]
}

// A header plus a (possibly empty) indented body, closed with `end`.
private wrap_body(header: str, body: str): str {
    if body == "" {
        return Text.lines([header, "end"])
    }
    return Text.lines([header, body, "end"])
}

// Append a block's emitted text to `parts` when it is non-empty.
private push_block(parts: List<str>, stmts: List<Node>): unit {
    mut body = .emit_block(stmts)
    if body != "" {
        parts.push(body)
    }
}

private with_self(params: List<str>): List<str> {
    mut out = ["self"]
    for param in params {
        out.push(param)
    }
    return out
}
