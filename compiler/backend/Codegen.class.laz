// Codegen — the backend façade: an analysed, optimised program in, Lua source
// out. The file lowers to a class table `C` (no metatables); top-level functions
// and static bindings become members, a non-static visibility binding an instance
// property seeded in `C.new`, and `import`/`extern` emit nothing. A constructor
// adds an entry footer `return C.new(...)`. The `__lz_*` prelude is prepended only
// when a collection/Option was emitted.

import backend.CgContext
import backend.ExprEmitter
import backend.StmtEmitter
import backend.Text
import frontend.parser.Node
import Meta

private class_name: str
private known_classes: Map<str, bool>
private externs: Map<str, Map<str, str>>
private variant_owner: Map<str, str>
private plat: str
private opt_level: int = 0
private mangler: dynamic = 0
private prebuilt_classes: dynamic = 0

constructor(class_name: str, imports: List<str>, externs: Map<str, Map<str, str>>, variant_owner: Map<str, str>, plat: str, opt_level: int, mangler: dynamic, prebuilt_classes: dynamic) {
    .class_name = class_name
    .known_classes = [:]
    for name in imports {
        .known_classes[name] = true
    }
    .externs = externs
    .variant_owner = variant_owner
    .plat = plat
    .opt_level = opt_level
    .mangler = mangler
    .prebuilt_classes = prebuilt_classes
}

// A whole single-file program as a self-contained Lua chunk: header, the class
// table, and — with a constructor — an entry footer. The stdlib helpers (List,
// Map, Option, Result) are pre-loaded by the Linker; no separate preamble needed.
public generate(program: Node): str {
    mut block = .class_block(program)

    mut sections = [Codegen.header(), block]
    if .has_constructor(program.child("body")) {
        sections.push("return " ++ .class_name ++ ".new(...)")
    }
    return Text.join(sections, Text.nl() ++ Text.nl())
}

// Just the class table `local C = {}` plus its member lines. The bundler emits the
// header/footer once for the whole program, so it composes class blocks instead of
// calling `generate`.
public class_block(program: Node): str {
    mut body = program.child("body")
    mut ctx = .build_context(body)
    mut exprs = ExprEmitter(ctx)
    mut stmts = StmtEmitter(ctx, exprs)
    exprs.inject_stmts(stmts)

    mut member_lines = [stmts.emit_member(stmt) for stmt in body if .is_emittable(stmt)]

    mut sep = Text.nl() ++ Text.nl()
    if .opt_level >= 1 {
        sep = Text.nl()
    }
    mut block = "local " ++ ctx.name() ++ " = {}"
    if member_lines.len() > 0 {
        block = block ++ sep ++ Text.join(member_lines, Text.nl())
    }
    return block
}

// Classify the top-level declarations into the member set, the instance-method set
// (and order), and the instance-property declarations.
private build_context(body: List<Node>): CgContext {
    mut members = [:]
    mut instance_methods = [:]
    mut instance_order = []
    mut properties = []
    for stmt in body {
        mut stmt_platform = stmt.attr("platform").unwrap_or("")
        if stmt_platform != "" and stmt_platform != .plat {
            // Skip platform-gated declarations that don't match the target platform.
            // Without this, the constructor would still emit `self.m = C.m` for absent methods.
        } else {
            mut k = stmt.kind
            if k == "FunctionDecl" {
                members[stmt.child("name")] = true
                if not stmt.attr("is_static").unwrap_or(false) {
                    instance_methods[stmt.child("name")] = true
                    instance_order.push(stmt.child("name"))
                }
            } else if k == "VariableDecl" {
                if .is_property(stmt) {
                    properties.push(stmt)
                } else {
                    members[stmt.child("name")] = true
                }
            }
        }
    }
    return CgContext(.class_name, members, instance_methods, instance_order, properties, .known_classes, .externs, .variant_owner, .opt_level, .mangler, .prebuilt_classes)
}

private is_property(stmt: Node): bool {
    mut visibility = stmt.attr("visibility").unwrap_or("")
    mut is_static = stmt.attr("is_static").unwrap_or(false)
    return visibility != "" and not is_static
}

// A declaration that contributes a member line: not an import/extern, and not an
// instance property (its default is seeded into `C.new` instead).
private is_emittable(stmt: Node): bool {
    mut k = stmt.kind
    if k == "ImportDecl" {
        return false
    }
    if k == "ExternDecl" {
        return false
    }
    if k == "TraitDecl" {
        return false
    }
    if k == "ImplementDecl" {
        return false
    }
    if k == "VariableDecl" and .is_property(stmt) {
        return false
    }
    mut stmt_platform = stmt.attr("platform").unwrap_or("")
    if stmt_platform != "" and stmt_platform != .plat {
        return false
    }
    return true
}

public has_constructor(body: List<Node>): bool {
    for stmt in body {
        if stmt.kind == "ConstructorDecl" {
            return true
        }
    }
    return false
}

public static header(): str {
    return Text.lines([
        "--------------------------------------------------------------------",
        "-- Generated by the " ++ Meta.name ++ " compiler v" ++ Meta.version ++ " (self-hosted)",
        "-- Target runtime: " ++ Meta.target,
        "-- This file is auto-generated. Do not edit by hand.",
        "--------------------------------------------------------------------"
    ])
}
