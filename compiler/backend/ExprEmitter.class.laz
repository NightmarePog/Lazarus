// ExprEmitter — lowers an expression AST node to a Lua source string. The
// interesting work is call dispatch, checked in order: an extern call -> its raw
// Lua target wrapped at the Option boundary; a built-in collection method -> its
// `__lz_*` helper; a class name in call position -> `C.new(...)`; a `self` method
// -> `C.m(self, ...)`; any other instance call -> Lua colon `obj:m(...)`;
// everything else -> a plain call.

import std.Str
import backend.CgContext
import backend.Text
import frontend.parser.Node

private static op_map = [
    "PLUS": "+",
    "MINUS": "-",
    "MULTIPLY": "*",
    "DIVIDE": "/",
    "POWER": "^",
    "CONCAT": "..",
    "EQ": "==",
    "NEQ": "~=",
    "LESS": "<",
    "LESS_EQUAL": "<=",
    "GREATER": ">",
    "GREATER_EQUAL": ">=",
    "AND": "and",
    "OR": "or"
]

// Option / Result methods — {class, fn} pairs for mangler-aware emission.
private static builtin_meta = [
    "is_some": ["cls": "Option", "fn": "__lz_is_some"],
    "is_none": ["cls": "Option", "fn": "__lz_is_none"],
    "is_ok": ["cls": "Result", "fn": "__lz_is_ok"],
    "is_err": ["cls": "Result", "fn": "__lz_is_err"],
    "unwrap": ["cls": "Option", "fn": "__lz_unwrap"],
    "unwrap_or": ["cls": "Option", "fn": "__lz_unwrap_or"],
    "error": ["cls": "Result", "fn": "error"]
]

// Resolve a builtin method name to its fully-qualified Lua target, using the
// mangler so -Os output stays consistent.
private builtin_target(field: str): Option<str> {
    mut entry = ExprEmitter.builtin_meta.get(field)
    if entry.is_none() {
        return Option.none()
    }
    mut e = entry.unwrap()
    return Option.some(.ctx.mangle_class(e["cls"]) ++ "." ++ .ctx.mangle_member(e["cls"], e["fn"]))
}

// Built-in constructors `Option.some/none` and `Result.ok/err`, keyed by
// `Type.method` — intercepted before dispatch_class so `Option` is not
// wrongly prepended as the first argument.
private static constructors = [
    "Option.some": "Option.some",
    "Option.none": "Option.none",
    "Result.ok": "Result.ok",
    "Result.err": "Result.err"
]

private stmt_emitter: dynamic
private pending: List<str> = []
constructor(.ctx: CgContext)

public inject_stmts(s: dynamic): unit {
    .stmt_emitter = s
}

// Drain any pending prefix statements accumulated by `?` propagation since the
// last call. Called by StmtEmitter at each statement boundary.
public take_pending(): List<str> {
    mut out = .pending
    .pending = []
    return out
}

public emit(node: Node): str {
    match node.kind {
        "LiteralExpr" => { return .emit_literal(node) }
        "IdentifierExpr" => { return .emit_identifier(node) }
        "SelfExpr" => { return .ctx.mangle_local("self") }
        "MemberExpr" => { return .emit_field(node) }
        "ListExpr" => { return .emit_list(node) }
        "MapExpr" => { return .emit_map(node) }
        "IndexExpr" => { return .emit_index(node) }
        "CallExpr" => { return .emit_call(node) }
        "UnaryExpr" => { return .emit_unary(node) }
        "BinaryExpr" => { return .emit_binary(node) }
        "ListComp" => { return .emit_list_comp(node) }
        "MapComp" => { return .emit_map_comp(node) }
        "InterpolatedString" => { return .emit_interp(node) }
        "FnExpr" => { return .emit_fn_expr(node) }
        "PropagateExpr" => { return .emit_propagate(node) }
        _ => {}
    }
    return ""
}

// Lowers `expr?` by pushing a temp-assign and Err-check to the pending list,
// then returning the unwrapped Ok value. The pending lines are prepended by
// StmtEmitter at the next statement boundary.
private emit_propagate(node: Node): str {
    mut temp = .ctx.fresh_temp()
    .pending.push("local " ++ temp ++ " = " ++ .emit(node.child("inner")))
    .pending.push("if " ++ temp ++ ".kind == 'err' then return " ++ temp ++ " end")
    return temp ++ ".value"
}

private emit_fn_expr(node: Node): str {
    return .stmt_emitter.emit_closure(node.child("params"), node.child("param_types"), node.child("body"))
}

// A list comprehension lowers to an immediately-invoked function that builds a
// fresh list: iterate the source with the same `__lz_each` form as a for-in,
// optionally guard with the filter, and push each element. The closure captures
// `self`, so `[.f(x) for x in xs]` works.
private emit_list_comp(node: Node): str {
    mut iter = .emit(node.child("iter"))
    mut temp = .ctx.fresh_temp()
    .ctx.push_scope()
    .declare_loop_vars(node.child("vars"))
    mut header = .each_header(node.child("vars"), iter)
    mut body = .comp_body(node, .lz_fn("List", "push") ++ "(" ++ temp ++ ", " ++ .emit(node.child("element")) ++ ")")
    .ctx.pop_scope()
    return "(function() local " ++ temp ++ " = " ++ .lz_fn("List", "new") ++ "() " ++ header ++ " " ++ body ++ " end return " ++ temp ++ " end)()"
}

private emit_map_comp(node: Node): str {
    mut iter = .emit(node.child("iter"))
    mut temp = .ctx.fresh_temp()
    .ctx.push_scope()
    .declare_loop_vars(node.child("vars"))
    mut header = .each_header(node.child("vars"), iter)
    mut body = .comp_body(node, .lz_fn("List", "__lz_idx_set") ++ "(" ++ temp ++ ", " ++ .emit(node.child("key")) ++ ", " ++ .emit(node.child("value")) ++ ")")
    .ctx.pop_scope()
    return "(function() local " ++ temp ++ " = " ++ .lz_fn("Map", "new") ++ "() " ++ header ++ " " ++ body ++ " end return " ++ temp ++ " end)()"
}

// Helper: qualified mangled name for a known runtime class method.
// Uses mangle_member so prebuilt stdlib method names are never mangled.
private lz_fn(cls: str, fn_name: str): str {
    return .ctx.mangle_class(cls) ++ "." ++ .ctx.mangle_member(cls, fn_name)
}

private declare_loop_vars(vars: List<str>): unit {
    for name in vars {
        .ctx.declare_local(name)
    }
}

// The loop body: the add expression, wrapped in `if <cond> then … end` for a
// filtered comprehension.
private comp_body(node: Node, add: str): str {
    mut cond = node.attr("cond")
    if cond.is_some() {
        return "if " ++ .emit(cond.unwrap()) ++ " then " ++ add ++ " end"
    }
    return add
}

// The `for … in List.__lz_each(iter) do` header, matching the for-in lowering:
// a single variable takes the value (index discarded); two take key and value.
private each_header(vars: List<str>, iter: str): str {
    mut each = .lz_fn("List", "__lz_each")
    mut mangled = [.ctx.mangle_local(v) for v in vars]
    if vars.len() == 1 {
        return "for _, " ++ mangled.get(1).unwrap() ++ " in " ++ each ++ "(" ++ iter ++ ") do"
    }
    return "for " ++ Text.join(mangled, ", ") ++ " in " ++ each ++ "(" ++ iter ++ ") do"
}

// A bare name: a nullary enum variant lowers to its owner-qualified form, anything
// else to the context's resolved name (local, member, or extern).
private emit_identifier(node: Node): str {
    mut id = node.child("name")
    if .ctx.is_variant(id) {
        return .ctx.variant_qualified(id)
    }
    return .ctx.emit_name(id)
}

private emit_literal(node: Node): str {
    mut lit_kind = node.child("lit_kind")
    mut value = node.child("value")
    if lit_kind == "string" {
        return .lua_quote_str(value)
    }
    if lit_kind == "boolean" {
        if value {
            return "true"
        }
        return "false"
    }
    if lit_kind == "nil" {
        return "nil"
    }
    return value
}

private emit_field(node: Node): str {
    // Member names are never mangled (see mangle_member). Only the class table variable
    // name is mangled, which emit_operand handles via emit_identifier / mangle_class.
    return .emit_operand(node.child("object")) ++ "." ++ node.child("field")
}

private emit_list(node: Node): str {
    return .lz_fn("List", "__lz_from") ++ "({" ++ Text.join(.emit_args(node.child("elements")), ", ") ++ "})"
}

private emit_map(node: Node): str {
    mut parts = ["[" ++ .emit(entry.child("key")) ++ "] = " ++ .emit(entry.child("value")) for entry in node.child("entries")]
    return .lz_fn("Map", "__lz_from") ++ "({" ++ Text.join(parts, ", ") ++ "})"
}

private emit_index(node: Node): str {
    return .lz_fn("List", "__lz_idx_get") ++ "(" ++ .emit(node.child("object")) ++ ", " ++ .emit(node.child("index")) ++ ")"
}

private emit_unary(node: Node): str {
    return "not " ++ .emit_operand(node.child("operand"))
}

private emit_binary(node: Node): str {
    mut left = .emit_operand(node.child("left"))
    mut right = .emit_operand(node.child("right"))
    mut op = node.child("op")
    if op == "MODULO" {
        return "(" ++ left ++ " - math.floor(" ++ left ++ " / " ++ right ++ ") * " ++ right ++ ")"
    }
    return left ++ " " ++ ExprEmitter.op_map.get(op).unwrap_or(op) ++ " " ++ right
}

private emit_call(node: Node): str {
    mut callee = node.child("callee")
    mut args = .emit_args(node.child("args"))

    if callee.kind == "MemberExpr" {
        mut object = callee.child("object")
        mut field = callee.child("field")

        if object.kind == "IdentifierExpr" {
            mut target = .ctx.extern_target(object.child("name"), field)
            if target.is_some() {
                mut ext = target.unwrap()
                mut call = ext["target"] ++ "(" ++ Text.join(args, ", ") ++ ")"
                if ext["wrap"] {
                    return .ctx.mangle_class("Option") ++ "." ++ .ctx.mangle_member("Option", "__lz_wrap") ++ "(" ++ call ++ ")"
                }
                return call
            }
            mut ctor_key = object.child("name") ++ "." ++ field
            if ExprEmitter.constructors.has(ctor_key) {
                mut cls_name = object.child("name")
                return .ctx.mangle_class(cls_name) ++ "." ++ .ctx.mangle_member(cls_name, field) ++ "(" ++ Text.join(args, ", ") ++ ")"
            }
        }

        mut dispatch_cls = node.attr("dispatch_class")
        if dispatch_cls.is_some() {
            mut dc = dispatch_cls.unwrap()
            return .ctx.mangle_class(dc) ++ "." ++ .ctx.mangle_member(dc, field) ++ "(" ++ Text.join(.with_receiver(object, args), ", ") ++ ")"
        }
        if not node.attr("known_method").unwrap_or(false) {
            mut helper = .builtin_target(field)
            if helper.is_some() {
                return helper.unwrap() ++ "(" ++ Text.join(.with_receiver(object, args), ", ") ++ ")"
            }
        }
    }

    if callee.kind == "IdentifierExpr" {
        mut name = callee.child("name")
        if .ctx.is_construction(name) {
            return .ctx.emit_name(name) ++ ".new(" ++ Text.join(args, ", ") ++ ")"
        }
    }

    if callee.kind == "MemberExpr" {
        mut object = callee.child("object")
        mut field = callee.child("field")
        if object.kind == "SelfExpr" and .ctx.is_instance_method(field) {
            return .ctx.name() ++ "." ++ field ++ "(" ++ Text.join(.with_receiver(object, args), ", ") ++ ")"
        }
        if not .receiver_is_class(object) {
            return .emit_operand(object) ++ ":" ++ field ++ "(" ++ Text.join(args, ", ") ++ ")"
        }
    }

    mut callee_src = .emit(callee)
    if callee.kind == "BinaryExpr" {
        callee_src = "(" ++ callee_src ++ ")"
    }
    return callee_src ++ "(" ++ Text.join(args, ", ") ++ ")"
}

// Emit an operand, parenthesising a binary/unary expression that would otherwise
// bind wrongly as an indexed/called/operated value.
private emit_operand(node: Node): str {
    mut src = .emit(node)
    if .needs_parens(node) {
        return "(" ++ src ++ ")"
    }
    return src
}

private needs_parens(node: Node): bool {
    return node.kind == "BinaryExpr" or node.kind == "UnaryExpr"
}

private receiver_is_class(object: Node): bool {
    if object.kind != "IdentifierExpr" {
        return false
    }
    return .ctx.is_construction(object.child("name"))
}

// The argument list with the receiver prepended (built-in and instance-method
// calls pass the receiver as the first argument).
private with_receiver(object: Node, args: List<str>): List<str> {
    mut out = [.emit_operand(object)]
    for arg in args {
        out.push(arg)
    }
    return out
}

private emit_args(nodes: List<Node>): List<str> {
    return [.emit(node) for node in nodes]
}

// Produces a Lua double-quoted string literal for `value`, escaping `"`, `\`,
// LF (→ \n), and CR (→ \r) manually so embedded newlines never produce the
// Lua 5.1 %q line-continuation form, which picks up surrounding indentation.
private lua_quote_str(value: str): str {
    mut n = Str.len(value).unwrap_or(0)
    mut dq = Str.char(34).unwrap_or("")
    mut bs = Str.char(92).unwrap_or("")
    mut lf = Str.char(10).unwrap_or("")
    mut cr = Str.char(13).unwrap_or("")
    mut result = ""
    mut i = 1
    while i <= n {
        mut c = Str.sub(value, i, i).unwrap_or("")
        if c == dq {
            result = result ++ bs ++ dq
        } else if c == lf {
            result = result ++ bs ++ "n"
        } else if c == cr {
            result = result ++ bs ++ "r"
        } else if c == bs {
            result = result ++ bs ++ bs
        } else {
            result = result ++ c
        }
        i = i + 1
    }
    return dq ++ result ++ dq
}

// Emits an InterpolatedString as a Lua concatenation expression. Empty string
// segments are skipped; a single piece is emitted unwrapped; all string
// segments use %q quoting; expression parts are wrapped in `tostring(...)`.
private emit_interp(node: Node): str {
    mut parts = node.child("parts")
    mut pieces = []
    mut i = 1
    while i <= parts.len() {
        mut part = parts.get(i).unwrap()
        if part.kind == "LiteralExpr" and part.child("lit_kind") == "string" {
            mut v = part.child("value")
            if v != "" {
                pieces.push(.lua_quote_str(v))
            }
        } else {
            pieces.push("tostring(" ++ .emit(part) ++ ")")
        }
        i = i + 1
    }
    if pieces.len() == 0 {
        return "''"
    }
    if pieces.len() == 1 {
        return pieces.get(1).unwrap()
    }
    return "(" ++ Text.join(pieces, " .. ") ++ ")"
}
