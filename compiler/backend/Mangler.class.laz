// Mangler — maps original names to short identifiers for -Os minification.
// Class names and their member names share one counter; local variables use another.
// Enum variant string tags are NOT mangled (they are runtime values checked with ==).

import std.Num
import std.Str

private class_map: Map<str, str> = [:]
private local_map: Map<str, str> = [:]
private class_counter: int = 0
private local_counter: int = 0
constructor()

// Integer division helper (Lazarus / is float division in Lua <5.4 targets).
private static idiv(a: int, b: int): int {
    mut af = Num.to_float(a).unwrap_or(0.0)
    mut bf = Num.to_float(b).unwrap_or(1.0)
    return Num.floor(af / bf).unwrap_or(0)
}

// Generate the Nth short identifier (0-based): a, b, ..., z, aa, ab, ..., az, ba, ...
private static short(n: int): str {
    mut letters = "abcdefghijklmnopqrstuvwxyz"
    mut base = 26
    mut out = ""
    mut idx = n
    loop {
        mut rem = idx - Mangler.idiv(idx, base) * base
        out = Str.sub(letters, rem + 1, rem + 1).unwrap_or("a") ++ out
        idx = Mangler.idiv(idx, base) - 1
        if idx < 0 {
            break
        }
    }
    return out
}

// Register an identity mapping so `name` always resolves to itself (used for prebuilt stdlib classes).
public pin(name: str): unit {
    .class_map[name] = name
}

// Map a class-level name (class table name or member/method name) to its short form.
public mangle_class(name: str): str {
    mut hit = .class_map.get(name)
    if hit.is_some() {
        return hit.unwrap()
    }
    mut s = Mangler.short(.class_counter)
    .class_counter = .class_counter + 1
    .class_map[name] = s
    return s
}

// Map a local variable name to its short form.
public mangle_local(name: str): str {
    mut hit = .local_map.get(name)
    if hit.is_some() {
        return hit.unwrap()
    }
    mut s = Mangler.short(.local_counter)
    .local_counter = .local_counter + 1
    .local_map[name] = s
    return s
}
