// CgContext — per-generation codegen state for the file = class model. A file
// lowers to a class table `C`; inside a body, a reference to another member is
// qualified (`C.other`) while locals and parameters stay bare. `emit_name` makes
// that call using the member set and a stack of local scopes (no metatables, so
// the scope chain is an explicit list searched outward).

import frontend.parser.Node

private cls: str
private members: Map<str, bool>
private instance_methods: Map<str, bool>
private instance_order: List<str>
private properties: List<Node>
private known_classes: Map<str, bool>
private externs: Map<str, Map<str, dynamic>>
private variant_owner: Map<str, str>
private opt_level_val: int = 0
private mangler_val: dynamic = 0
private prebuilt_classes_val: dynamic = 0
constructor(cls: str, members: Map<str, bool>, instance_methods: Map<str, bool>, instance_order: List<str>, properties: List<Node>, known_classes: Map<str, bool>, externs: Map<str, Map<str, dynamic>>, variant_owner: Map<str, str>, opt_level: int, mangler: dynamic, prebuilt_classes: dynamic) {
    .cls = cls
    .members = members
    .instance_methods = instance_methods
    .instance_order = instance_order
    .properties = properties
    .known_classes = known_classes
    .externs = externs
    .variant_owner = variant_owner
    .opt_level_val = opt_level
    .mangler_val = mangler
    .prebuilt_classes_val = prebuilt_classes
}
private scopes: List<Map<str, bool>> = [[:]]
private temp_seq: int = 0

// A fresh, collision-free local name for a generated temporary (e.g. a `match`
// scrutinee). Unique within this class block.
public fresh_temp(): str {
    .temp_seq = .temp_seq + 1
    return f"__lz_m{.temp_seq}"
}

public opt_level(): int {
    return .opt_level_val
}

public mangle_class(n: str): str {
    if .opt_level_val < 3 or .mangler_val == 0 {
        return n
    }
    return .mangler_val.mangle_class(n)
}

public mangle_local(n: str): str {
    if .opt_level_val < 3 or .mangler_val == 0 {
        return n
    }
    return .mangler_val.mangle_local(n)
}

// Method and member names are never mangled: raw Lua bodies in stdlib and instance
// method tables use original names, so mangling would break colon-dispatch without
// full type inference to route every call through the class-table path.
public mangle_member(cls: str, member: str): str {
    return member
}

// mangle_member for the current class (used in emit_method, emit_static_field, etc.).
public mangle_self_member(member: str): str {
    return member
}

public name(): str {
    return .mangle_class(.cls)
}

// Instance-method names in declaration order (for the `self.m = C.m` copies).
public instance_method_names(): List<str> {
    return .instance_order
}

// The instance-property declarations, whose defaults seed `C.new`.
public property_decls(): List<Node> {
    return .properties
}

public is_member(name: str): bool {
    return .members.has(name)
}

public is_instance_method(name: str): bool {
    return .instance_methods.has(name)
}

// Whether `name` names a class (this one or an import) — so `name(...)` is
// construction and `name.m(...)` is a static, not a colon, call.
public is_construction(name: str): bool {
    if name == .cls {
        return true
    }
    return .known_classes.has(name)
}

// The extern binding entry (`["target": t, "wrap": b]`) a member lowers to, or
// None when `ns`.`member` is not an extern binding in scope.
public extern_target(ns: str, member: str): Option<dynamic> {
    mut table = .externs.get(ns)
    if table.is_none() {
        return table
    }
    return table.unwrap().get(member)
}

public push_scope(): unit {
    .scopes.push([:])
}

public pop_scope(): unit {
    .scopes.pop()
}

public declare_local(name: str): unit {
    mut top = .scopes.get(.scopes.len()).unwrap()
    top[name] = true
}

public is_local(name: str): bool {
    for scope in .scopes {
        if scope.has(name) {
            return true
        }
    }
    return false
}

// Whether `name` is a bare enum variant (so `Some(5)` / `None` lower to the
// owner-qualified `Owner.Some(5)` / `Owner.None` the enum block emits).
public is_variant(name: str): bool {
    return .variant_owner.has(name)
}

public variant_qualified(name: str): str {
    mut owner = .variant_owner.get(name).unwrap()
    return .mangle_class(owner) + "." + .mangle_member(owner, name)
}

// Qualify a member reference as `C.name`; leave locals, parameters and globals bare.
public emit_name(name: str): str {
    if .is_local(name) {
        return .mangle_local(name)
    }
    if .is_member(name) {
        return .mangle_class(.cls) + "." + .mangle_self_member(name)
    }
    return .mangle_class(name)
}
