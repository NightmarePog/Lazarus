// MetaEmitter — serialises a class signature (as produced by Main.collect_signatures)
// into a LAZARUS_META comment block prepended to compiled .lua files. The block lets
// the linker reconstruct type information without the .laz source.

import std.Str
import backend.Text

// Returns the keys of a Lazarus map sorted alphabetically, so JSON output is
// deterministic across Lua VM instances (pairs() order is undefined).
private lua sorted_keys(m): List<str> {
    local keys = {}
    for k, _ in pairs(m.items) do
        keys[#keys + 1] = k
    end
    table.sort(keys)
    return { kind = 'list', items = keys }
}

// Returns the value for key k from a Lazarus map (raw, not Option-wrapped).
private lua map_raw_get(m, k): dynamic {
    return m.items[k]
}

// Produce the full --[[LAZARUS_META\n<json>\n]] block for one class.
emit(class_name: str, sig: dynamic): str {
    mut nl = Text.nl()
    return "--[[LAZARUS_META" ++ nl ++ MetaEmitter.sig_json(class_name, sig) ++ nl ++ "]]"
}

private sig_json(class_name: str, sig: dynamic): str {
    mut f = MetaEmitter.fields_json(sig.get("fields").unwrap())
    mut m = MetaEmitter.methods_json(sig.get("methods").unwrap())
    mut ct = MetaEmitter.type_list_json(sig.get("ctor").unwrap())
    mut cn = MetaEmitter.str_list_json(sig.get("ctor_names").unwrap_or([]))
    mut tv = MetaEmitter.str_list_json(sig.get("type_params").unwrap_or([]))
    return "{\"class\":" ++ MetaEmitter.qstr(class_name) ++ ",\"fields\":" ++ f ++ ",\"methods\":" ++ m ++ ",\"ctor\":" ++ ct ++ ",\"cnames\":" ++ cn ++ ",\"tvars\":" ++ tv ++ "}"
}

// Use sorted_keys() so JSON output is deterministic across Lua VM instances.
private fields_json(fields: dynamic): str {
    mut out = []
    for key in MetaEmitter.sorted_keys(fields) {
        mut val = MetaEmitter.map_raw_get(fields, key)
        mut type_j = "null"
        if val.is_some() {
            type_j = MetaEmitter.type_json(val.unwrap())
        }
        out.push(MetaEmitter.qstr(key) ++ ":" ++ type_j)
    }
    return "{" ++ Text.join(out, ",") ++ "}"
}

private methods_json(methods: dynamic): str {
    mut out = []
    for name in MetaEmitter.sorted_keys(methods) {
        mut sig = MetaEmitter.map_raw_get(methods, name)
        out.push(MetaEmitter.qstr(name) ++ ":" ++ MetaEmitter.method_json(sig))
    }
    return "{" ++ Text.join(out, ",") ++ "}"
}

private method_json(sig: dynamic): str {
    mut p = MetaEmitter.type_list_json(sig.get("params").unwrap_or([]))
    mut pn = MetaEmitter.str_list_json(sig.get("param_names").unwrap_or([]))
    mut result = sig.get("result").unwrap_or(0)
    mut r = "null"
    if result != 0 {
        r = MetaEmitter.type_json(result)
    }
    mut s = "false"
    if sig.get("is_static").unwrap_or(false) {
        s = "true"
    }
    mut tv = MetaEmitter.str_list_json(sig.get("type_params").unwrap_or([]))
    return "{\"params\":" ++ p ++ ",\"pnames\":" ++ pn ++ ",\"result\":" ++ r ++ ",\"static\":" ++ s ++ ",\"tvars\":" ++ tv ++ "}"
}

// types is either 0 (no-ctor sentinel) or List<Node>
private type_list_json(types: dynamic): str {
    if types == 0 {
        return "[]"
    }
    mut parts = []
    for t in types {
        parts.push(MetaEmitter.type_json(t))
    }
    return "[" ++ Text.join(parts, ",") ++ "]"
}

private type_json(node: dynamic): str {
    if node == 0 {
        return "null"
    }
    mut name = node.child("name")
    mut args_j = MetaEmitter.type_list_json(node.child("args"))
    return "{\"name\":" ++ MetaEmitter.qstr(name) ++ ",\"args\":" ++ args_j ++ "}"
}

private str_list_json(items: List<str>): str {
    mut parts = [MetaEmitter.qstr(s) for s in items]
    return "[" ++ Text.join(parts, ",") ++ "]"
}

// Quote and JSON-escape a string (handles the ASCII chars used in type names).
private qstr(s: str): str {
    mut len = Str.len(s).unwrap_or(0)
    mut out = "\""
    mut i = 1
    loop {
        if i > len { break }
        mut ch = Str.sub(s, i, i).unwrap_or("")
        if ch == "\"" {
            out = out ++ "\\\""
        } else if ch == "\\" {
            out = out ++ "\\\\"
        } else {
            out = out ++ ch
        }
        i = i + 1
    }
    return out ++ "\""
}
