import std.Sys

constructor() {
    mut name = "world"
    mut n = 42
    Sys.print(f"hello {name}, number {n + 1}")
    Sys.print(f"{name} and {name}")
    Sys.print(f"no interp here")

    mut triple = """
        line one
        line two
        """
    Sys.print(triple)

    mut ftriple = f"""
        Generated by {name}
        Number: {n}
        """
    Sys.print(ftriple)
}
