// Num — extern bindings to Lua's `math` library plus `tonumber` / `tostring`,
// and pure-Lazarus numeric helpers. `to_number` wraps at the Option boundary
// (None for a non-numeric string). to_text / to_int / to_float are left with
// untyped params because callers pass both int and float — tostring/tonumber/
// math.floor accept any number in Lua.

#object

extern floor(x: float): Option<int> = "math.floor"
extern ceil(x: float): Option<int> = "math.ceil"
extern abs(x: float): Option<float> = "math.abs"
extern sqrt(x: float): float = "math.sqrt"
// max/min are variadic in Lua — left untyped.
extern max(a, b) = "math.max"
extern min(a, b) = "math.min"
extern to_number(s: str): Option<float> = "tonumber"
// to_text/to_int/to_float accept both int and float — left untyped.
extern to_text(n): Option<str> = "tostring"
extern to_int(x): Option<int> = "math.floor"
extern to_float(x): Option<float> = "tonumber"

clamp(v: int, lo: int, hi: int): int {
    if v < lo {
        return lo
    }
    if v > hi {
        return hi
    }
    return v
}

// Integer exponentiation; any exponent below 1 yields 1.
pow(base: int, exp: int): int {
    mut result = 1
    mut i = 0
    while i < exp {
        result = result * base
        i = i + 1
    }
    return result
}

// Rounds half up: 2.5 -> 3, -2.5 -> -2.
round(x: float): int {
    return Num.floor(x + 0.5).unwrap_or(0)
}
