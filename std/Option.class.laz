import std.Sys

private static lua __lz_wrap(v): dynamic {
    if v == nil then return 'None' end
    return { kind = 'Some', _1 = v }
}
private static lua __lz_unwrap(o): dynamic {
    if type(o) == 'table' and (o.kind == 'Some' or o.kind == 'Ok') then return o._1 end
    if type(o) == 'table' and o.kind == 'Err' then error(o._1) end
    error('unwrap of a None value')
}
private static lua __lz_unwrap_or(o, d): dynamic {
    if type(o) == 'table' and (o.kind == 'Some' or o.kind == 'Ok') then return o._1 end
    return d
}
private static lua __lz_is_some(o): bool {
    return type(o) == 'table' and o.kind == 'Some'
}
private static lua __lz_is_none(o): bool {
    return o == 'None' or type(o) ~= 'table'
}

enum Option<T> {
    Some(T),
    None
}

static some<T>(value: T): Option<T> {
    return Some(value)
}

static none<T>(): Option<T> {
    return None
}

static is_some<T>(opt: Option<T>): bool {
    match opt {
        Some(_) => { return true }
        None => { return false }
    }
}

static is_none<T>(opt: Option<T>): bool {
    match opt {
        None => { return true }
        Some(_) => { return false }
    }
}

static unwrap<T>(opt: Option<T>): T {
    match opt {
        Some(v) => { return v }
        None => { Sys.panic("unwrap of None") }
    }
}

static unwrap_or<T>(opt: Option<T>, default: T): T {
    match opt {
        Some(v) => { return v }
        None => { return default }
    }
}
