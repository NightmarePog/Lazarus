// Str — extern bindings to Lua's `string` library. Typed params let the type
// checker validate call sites. `find` uses a single-return shim (`__lz_str_find`)
// since the language has no multiple returns: it yields the 1-based match start,
// or None when absent. All string functions wrap their result at the Option boundary.

extern upper(s: str): Option<str> = "string.upper"
extern lower(s: str): Option<str> = "string.lower"
extern len(s: str): Option<int> = "string.len"
extern sub(s: str, i: int, j: int): Option<str> = "string.sub"
extern byte(s: str, i: int): Option<int> = "string.byte"
extern char(n: int): Option<str> = "string.char"
extern rep(s: str, n: int): Option<str> = "string.rep"
extern find(s: str, sub: str): Option<int> = "__lz_str_find"
// format is variadic in Lua — left untyped so callers can pass any number of args.
extern format(fmt) = "string.format"
