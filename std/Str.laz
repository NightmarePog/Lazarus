// Str — extern bindings to Lua's `string` library. Calls forward their args and
// wrap the result at the Option boundary. `find` uses a single-return shim
// (`__lz_str_find`), since the language has no multiple returns: it yields the
// 1-based match start, or None when absent.

extern upper(s) = "string.upper"
extern lower(s) = "string.lower"
extern len(s) = "string.len"
extern sub(s, i, j) = "string.sub"
extern byte(s, i) = "string.byte"
extern char(n) = "string.char"
extern rep(s, n) = "string.rep"
extern format(fmt) = "string.format"
extern find(s, sub) = "__lz_str_find"
