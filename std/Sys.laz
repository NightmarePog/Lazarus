// Sys — extern bindings to Lua's process / IO / runtime functions. Extern calls
// forward their args and wrap their result at the Option boundary (a Lua nil
// becomes `Option.none()`). `panic` binds to Lua's `error`, which never returns.

extern panic(message: str): unit = "error"
extern print(s): unit = "print"
extern write(s: str): unit = "io.write"
extern read_line(): Option<str> = "io.read"
extern read_all(fmt: str): Option<str> = "io.read"
extern argv(i: int): Option<str> = "__lz_argv"
extern read_file(path: str): Option<str> = "__lz_readfile"
extern time(): Option<int> = "os.time"
extern clock(): Option<float> = "os.clock"
extern exit(code: int): unit = "os.exit"
extern open(s: str, mode: str) = "io.open"
extern file_exists(path: str): bool = "__lz_exists"
extern exec(cmd: str): int = "__lz_exec"
extern capture(cmd: str): Option<str> = "__lz_popen"
extern write_file(path: str, content: str): bool = "__lz_write_file"
extern mkdir(path: str): bool = "__lz_mkdir"
